{
    "name": "@nyar/project-nyar",
    "version": "1.0.0",
    "private": true,
    "description": "Nyar Virtual Machine and Tooling",
    "scripts": {
        "test": "pnpm -r test",
        "build": "pnpm -r build",
        "build:napi": "node scripts/build.mjs napi",
        "build:wasm": "node scripts/build.mjs wasm",
        "build:native": "npx tsx scripts/build.ts",
        "prepare:npm": "node scripts/prepare-npm-publish.mjs",
        "check:npm-versions": "node scripts/check-nyar-workspace-versions.mjs",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:trust": "nifty trust",
        "fmt": "nifty format",
        "fmt:check": "nifty format --check",
        "format": "nifty format",
        "lint": "pnpm fmt:check",
        "check": "cargo cry --manifest-path projects/nyar.rs/Cargo.toml",
        "check:doc": "cargo-cry doc --manifest-path projects/nyar.rs/Cargo.toml",
        "p": "cargo workspaces publish --no-git-commit --allow-dirty --yes",
        "u": "cargo upgrade --incompatible"
    },
    "dependencies": {},
    "devDependencies": {
        "@doki-land/nifty": "0.1.10",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@12.14.0"
}
