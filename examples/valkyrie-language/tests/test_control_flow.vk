let x = 3
if x < 0 { print(-1) }
else if x == 0 { print(0) }
else { print(1) }
# Expect: 1

class Counter { value }
let c = new Counter
c.value = 0
while c.value < 3 {
  print(c.value)
  c.value = c.value + 1
}
# Expect: 0
# Expect: 1
# Expect: 2

class Box { v }
let b = new Box
b.v = 0
loop {
  b.v = b.v + 1
  if b.v == 2 { continue }
  print(b.v)
  if b.v == 4 { break }
}
# Expect: 1
# Expect: 3
# Expect: 4
