namespace Math {
  micro add(x, y) { return x + y }
  class Box { v }
}

using Math
print(add(1, 2))        # Expect: 3
let b = new Box
b.v = 7
print(b.v)              # Expect: 7

namespace Outer {
  namespace Inner {
    micro twice(x) { return x + x }
    class Point { x, y }
  }
}

using Outer::Inner
print(twice(10))        # Expect: 20
let p = new Point
p.x = 1
p.y = 2
print(p.x)              # Expect: 1
print(p.y)              # Expect: 2

# Direct qualified usage without using
print(Outer::Inner::twice(5))  # Expect: 10
let p2 = new Outer::Inner::Point
p2.x = 3
p2.y = 4
print(p2.x)             # Expect: 3
print(p2.y)             # Expect: 4
