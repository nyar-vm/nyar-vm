using package::ast

let l = [1, 2, 3]
print("Initial list len: " + str(len(l)))
l.push(4)
print("After push len: " + str(len(l)))
print("l[0]: " + str(l[0]))
l[0] = 10
print("After set l[0]: " + str(l[0]))
let p = l.pop()
print("Popped: " + str(p))
print("Final len: " + str(len(l)))

l.unshift(0)
print("After unshift(0): " + str(l[0]))
let s = l.shift()
print("Shifted: " + str(s))
