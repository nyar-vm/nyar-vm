using package::lexer::Lexer
using package::parser::Parser
using package::compiler::Compiler
using package::ast::Stmt
using package::ast::List

print("vcc bootstrap started...")

let files = new List
files.push("examples/valkyrie-bootstrap/library/ast/ast.vk")
files.push("examples/valkyrie-bootstrap/library/ast/lexer.vk")
files.push("examples/valkyrie-bootstrap/library/ast/parser.vk")
files.push("examples/valkyrie-bootstrap/library/hir/hir.vk")
files.push("examples/valkyrie-bootstrap/library/hir/transformer.vk")
files.push("examples/valkyrie-bootstrap/library/lir/lir.vk")
files.push("examples/valkyrie-bootstrap/library/lir/backends/wasm.vk")
files.push("examples/valkyrie-bootstrap/library/lir/backends/jvm.vk")
files.push("examples/valkyrie-bootstrap/library/lir/backends/clr.vk")
files.push("examples/valkyrie-bootstrap/library/lir/backends/llvm.vk")
files.push("examples/valkyrie-bootstrap/library/lir/backends/native.vk")
files.push("examples/valkyrie-bootstrap/library/mir/mir.vk")
files.push("examples/valkyrie-bootstrap/library/mir/compiler.vk")
files.push("examples/valkyrie-bootstrap/test/call_macro.vk")
files.push("examples/valkyrie-bootstrap/binary/vcc/main.vk")

let all_stmts = new List
let i = 0
let n = files.len()

while i < n {
    let path = files.get(i)
    print("Compiling " + path + "...")
    let code = read_file(path)
    if code == "" {
        print("Failed to read file (or empty): " + path)
    } else {
        let lexer = Lexer::new(code)
        let parser = Parser::new(lexer)
        let stmts = parser.parse_all()
        let j = 0
        let m = stmts.len()
        while j < m {
            all_stmts.push(stmts.get(j))
            j = j + 1
        }
    }
    i = i + 1
}

let program = Stmt::Block(all_stmts, null)
print("Parsing complete. Starting compilation...")
let compiler = Compiler::new()
compiler.compile(program)
print("Bootstrap compilation finished.")
