namespace package::backend::wasm;

using package::lir
using package::ast

class WasmBackend { }

imply WasmBackend {
  micro contains(list, item) {
    let i = 0
    let n = list.len()
    while i < n {
      if eq(list.get(i), item) { return true }
      i = i + 1
    }
    return false
  }
  micro collect_locals(func) {
    let locals = new List
    let i = 0
    let na = func.args.len()
    while i < na {
      let a = func.args.get(i)
      if !WasmBackend::contains(locals, a) { locals.push(a) }
      i = i + 1
    }
    let j = 0
    let nb = func.blocks.len()
    while j < nb {
      let b = func.blocks.get(j)
      let k = 0
      let ni = b.instrs.len()
      while k < ni {
        let inst = b.instrs.get(k)
        let tag = inst.__variant__
        if tag == "LoadLocal" || tag == "StoreLocal" {
          let name = inst._0
          if !WasmBackend::contains(locals, name) { locals.push(name) }
        }
        k = k + 1
      }
      j = j + 1
    }
    return locals
  }
  micro format_params(args) {
    let s = ""
    let i = 0
    let n = args.len()
    while i < n {
      s = s + " (param i64)"
      i = i + 1
    }
    return s
  }
  micro find_end_for_if(instrs, start_idx, else_id) {
    let i = start_idx + 1
    let n = instrs.len()
    while i < n {
      let inst = instrs.get(i)
      let tag = inst.__variant__
      if tag == "Label" {
        if inst._0 == else_id { break }
      } else {
        if tag == "Jump" {
          return inst._0
        }
      }
      i = i + 1
    }
    return -1
  }
  micro remove(list, item) {
    let i = 0
    let n = list.len()
    let prev = null
    let cur = list
    while i < n {
      if eq(cur.head, item) {
        if prev {
          prev.tail = cur.tail
        } else {
          list.head = null
          list.tail = null
        }
        return true
      }
      prev = cur
      cur = cur.tail
      i = i + 1
    }
    return false
  }
  micro string_id(lir, s) {
    let i = 0
    let n = lir.constants.len()
    while i < n {
      let c = lir.constants.get(i)
      if c.__variant__ == "String" {
        if eq(c._0, s) { return i }
      }
      i = i + 1
    }
    return 0
  }
  micro emit_block_instrs(self, lir, instrs) {
    let out = ""
    let i = 0
    let n = instrs.len()
    let open_else = new List
    let open_end = new List
    while i < n {
      let inst = instrs.get(i)
      let tag = inst.__variant__
      if tag == "ConstInt" {
        out = out + "    i64.const " + inst._0 + "\n"
      } else {
        if tag == "ConstString" {
          let sid = WasmBackend::string_id(lir, inst._0)
          out = out + "    i64.const " + sid + "\n"
        } else {
          if tag == "LoadLocal" {
            out = out + "    local.get $" + inst._0 + "\n"
          } else {
            if tag == "StoreLocal" {
              out = out + "    local.set $" + inst._0 + "\n"
            } else {
              if tag == "AddI64" {
                out = out + "    i64.add\n"
              } else {
                if tag == "SubI64" {
                  out = out + "    i64.sub\n"
                } else {
                  if tag == "MulI64" {
                    out = out + "    i64.mul\n"
                  } else {
                    if tag == "DivI64" {
                      out = out + "    i64.div_s\n"
                    } else {
                      if tag == "Call" {
                        out = out + "    ;; call " + inst._0 + " argc " + inst._1 + "\n"
                      } else {
                        if tag == "CallFFI" {
                          if inst._0 == "print" {
                            out = out + "    drop\n"
                            out = out + "    i32.const 0\n"
                            out = out + "    i32.const 0\n"
                            out = out + "    i32.const 0\n"
                            out = out + "    i32.const 0\n"
                            out = out + "    call $fd_write\n"
                            out = out + "    drop\n"
                          } else {
                            out = out + "    ;; ffi " + inst._0 + " argc " + inst._1 + "\n"
                          }
                        } else {
                          if tag == "EqI64" {
                            out = out + "    i64.eq\n"
                          } else {
                            if tag == "EqStr" {
                              out = out + "    i64.eq\n"
                            } else {
                            if tag == "Return" {
                              out = out + "    return\n"
                            } else {
                              if tag == "Pop" {
                                out = out + "    drop\n"
                              } else {
                                if tag == "JumpIfFalse" {
                                  let else_id = inst._0
                                  let end_id = WasmBackend::find_end_for_if(instrs, i, else_id)
                                  if end_id != -1 {
                                    open_else.push(else_id)
                                    open_end.push(end_id)
                                    out = out + "    block $L" + end_id + "\n"
                                    out = out + "    block $L" + else_id + "\n"
                                  }
                                  out = out + "    i64.eqz\n"
                                  out = out + "    br_if $L" + else_id + "\n"
                                } else {
                                  if tag == "Jump" {
                                    out = out + "    br $L" + inst._0 + "\n"
                                  } else {
                                    if tag == "Label" {
                                      let lid = inst._0
                                      if WasmBackend::contains(open_else, lid) {
                                        out = out + "    end\n"
                                        WasmBackend::remove(open_else, lid)
                                      } else {
                                        if WasmBackend::contains(open_end, lid) {
                                          out = out + "    end\n"
                                          WasmBackend::remove(open_end, lid)
                                        } else {
                                          out = out + "    ;; label " + lid + "\n"
                                        }
                                      }
                                    } else {
                                      out = out + "    ;; " + tag + "\n"
                                    }
                                  }
                                }
                              }
                            }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
      i = i + 1
    }
    return out
  }
  micro emit_core(self, lir) {
    let s = "(module\n"
    s = s + "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n"
    let i = 0
    let n = lir.functions.len()
    while i < n {
      let f = lir.functions.get(i)
      s = s + "  (func $" + f.name + WasmBackend::format_params(f.args) + "\n"
      let locals = WasmBackend::collect_locals(f)
      let li = 0
      let ln = locals.len()
      while li < ln {
        let lname = locals.get(li)
        s = s + "    (local $" + lname + " i64)\n"
        li = li + 1
      }
      let j = 0
      let nb = f.blocks.len()
      while j < nb {
        let b = f.blocks.get(j)
        let k = 0
        let ni = b.instrs.len()
        let has_loop = false
        if ni > 0 {
          let inst0 = b.instrs.get(0)
          if inst0.__variant__ == "Label" {
            let exit_id = -1
            let t = 1
            while t < ni {
              let x = b.instrs.get(t)
              if x.__variant__ == "JumpIfFalse" { exit_id = x._0 }
              t = t + 1
            }
            if exit_id != -1 {
              s = s + "    block $L" + exit_id + "\n"
              s = s + "    loop $L" + inst0._0 + "\n"
              has_loop = true
            }
          }
        }
        s = s + WasmBackend::emit_block_instrs(self, lir, b.instrs)
        if has_loop {
          s = s + "    end\n"
          s = s + "    end\n"
        }
        j = j + 1
      }
      s = s + "  )\n"
      s = s + "  (export \"" + f.name + "\" (func $" + f.name + "))\n"
      i = i + 1
    }
    s = s + ")\n"
    return s
  }
  micro emit_component(self, lir) {
    let core = WasmBackend::emit_core(self, lir)
    let s = "(component\n"
    s = s + "  (core module $core " + core + ")\n"
    let i = 0
    let n = lir.functions.len()
    while i < n {
      let f = lir.functions.get(i)
      s = s + "  (export \"" + f.name + "\" (func $core." + f.name + "))\n"
      i = i + 1
    }
    s = s + ")\n"
    return s
  }
  micro emit(self, lir) {
    return WasmBackend::emit_core(self, lir)
  }
  micro output_path(self) {
    return "examples/valkyrie-bootstrap/target/vcc.wasm"
  }
  micro component_output_path(self) {
    return "examples/valkyrie-bootstrap/target/vcc.component.wat"
  }
}
