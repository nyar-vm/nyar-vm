namespace package::backend::jvm;

using package::lir

class JVMBackend { }

imply JVMBackend {
  micro emit(self, lir) {
    let s = ".class public vcc\n.super java/lang/Object\n"
    let i = 0
    let n = lir.functions.len()
    while i < n {
      let f = lir.functions.get(i)
      s = s + ".method public static " + f.name + "\n"
      let j = 0
      let nb = f.blocks.len()
      while j < nb {
        let b = f.blocks.get(j)
        let k = 0
        let ni = b.instrs.len()
        while k < ni {
          let inst = b.instrs.get(k)
          let tag = inst.__variant__
          if tag == "ConstInt" {
            s = s + "  ; const " + inst._0 + "\n"
          } else {
            if tag == "ConstString" {
              s = s + "  ; const \"" + inst._0 + "\"\n"
            } else {
              if tag == "LoadLocal" {
                s = s + "  ; load " + inst._0 + "\n"
              } else {
                if tag == "StoreLocal" {
                  s = s + "  ; store " + inst._0 + "\n"
                } else {
                  if tag == "EqI64" {
                    s = s + "  ; i64.eq\n"
                  } else {
                    if tag == "EqStr" {
                      s = s + "  ; i64.eq\n"
                    } else {
                  if tag == "AddI64" {
                    s = s + "  ; iadd\n"
                  } else {
                    if tag == "SubI64" {
                      s = s + "  ; isub\n"
                    } else {
                      if tag == "MulI64" {
                        s = s + "  ; imul\n"
                      } else {
                        if tag == "DivI64" {
                          s = s + "  ; idiv\n"
                        } else {
                          if tag == "CallFFI" {
                            s = s + "  ; ffi " + inst._0 + " argc " + inst._1 + "\n"
                          } else {
                            if tag == "Return" {
                              s = s + "  return\n"
                            } else {
                              if tag == "Pop" {
                                s = s + "  pop\n"
                              } else {
                                if tag == "Label" {
                                  s = s + "  ; label " + inst._0 + "\n"
                                } else {
                                  if tag == "Jump" {
                                    s = s + "  ; goto " + inst._0 + "\n"
                                  } else {
                                    if tag == "JumpIfFalse" {
                                      s = s + "  ; ifeq " + inst._0 + "\n"
                                    } else {
                                      s = s + "  ; " + tag + "\n"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  }
                }
              }
            }
          }
          }
          k = k + 1
        }
        j = j + 1
      }
      s = s + ".end method\n"
      i = i + 1
    }
    return s
  }
  micro output_path(self) {
    return "examples/valkyrie-bootstrap/target/vcc.jar"
  }
}
