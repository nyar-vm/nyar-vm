namespace package::hir;

class Module { ns, imports, funcs, macros, class_list, impl_list, init_stmts }

class HIRFunc { name, args, body }
class HIRMacro { name, args, body }
class HIRClass { name, fields }
class HIRImpl { class_name, methods }

imply Module {
  micro new() {
    let m = new Module
    m.ns = ""
    m.imports = new List
    m.funcs = new List
    m.macros = new List
    m.class_list = new List
    m.impl_list = new List
    m.init_stmts = new List
    return m
  }
}

imply HIRFunc {
  micro new(name, args, body) {
    let f = new HIRFunc
    f.name = name
    f.args = args
    f.body = body
    return f
  }
}

imply HIRMacro {
  micro new(name, args, body) {
    let f = new HIRMacro
    f.name = name
    f.args = args
    f.body = body
    return f
  }
}

imply HIRClass {
  micro new(name, fields) {
    let c = new HIRClass
    c.name = name
    c.fields = fields
    return c
  }
}

imply HIRImpl {
  micro new(class_name, methods) {
    let x = new HIRImpl
    x.class_name = class_name
    x.methods = methods
    return x
  }
}
