namespace package::hir;

using package::ast;

class Transformer { module }

imply Transformer {
    micro new() {
        let t = new Transformer;
        t.module = Module::new();
        return t;
    }

    micro transform(self, stmts) {
        let cur = stmts;
        while cur {
            if cur.head {
                self.visit_stmt(cur.head);
            }
            cur = cur.tail;
        }
        return self.module;
    }

    micro visit_stmt(self, stmt) {
        match stmt {
            case ast::Stmt::Namespace(name, _):
                self.module.ns = name;
            case ast::Stmt::Using(path, _):
                self.module.imports.push(path);
            case ast::Stmt::Class(name, fields, _):
                let c = HIRClass::new(name, fields);
                self.module.class_list.push(c);
            case ast::Stmt::Imply(name, methods, _):
                let hir_methods = new ast::List;
                let cur = methods;
                while cur {
                    if cur.head {
                        match cur.head {
                            case ast::Stmt::Micro(n, a, b, _):
                                let f = HIRFunc::new(n, a, b);
                                hir_methods.push(f);
                            case _:
                        }
                    }
                    cur = cur.tail;
                }
                let imp = HIRImpl::new(name, hir_methods);
                self.module.impl_list.push(imp);
            case ast::Stmt::Micro(name, args, body, _):
                let f = HIRFunc::new(name, args, body);
                self.module.funcs.push(f);
            case ast::Stmt::Macro(name, args, body, _):
                let f = HIRMacro::new(name, args, body);
                self.module.macros.push(f);
            case _:
                self.module.init_stmts.push(stmt);
        }
    }
}
