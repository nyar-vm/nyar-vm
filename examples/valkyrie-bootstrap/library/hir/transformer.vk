namespace package::hir;

using package::ast;

class Transformer { module }

imply Transformer {
    micro new() {
        let t = new Transformer;
        t.module = Module::new();
        return t;
    }

    micro transform(self, stmts) {
        let cur = stmts;
        while cur {
            if cur.head {
                self.visit_stmt(cur.head);
            }
            cur = cur.tail;
        }
        return self.module;
    }

    micro visit_stmt(self, stmt) {
        match stmt {
            ast::Stmt::Namespace(name) => {
                self.module.ns = name;
            }
            ast::Stmt::Using(path) => {
                self.module.imports.push(path);
            }
            ast::Stmt::Class(name, fields) => {
                let c = HIRClass::new(name, fields);
                self.module.class_list.push(c);
            }
            ast::Stmt::Imply(name, methods) => {
                let hir_methods = new ast::List;
                let cur = methods;
                while cur {
                    if cur.head {
                        match cur.head {
                            ast::Stmt::Micro(n, a, b) => {
                                let f = HIRFunc::new(n, a, b);
                                hir_methods.push(f);
                            }
                            _ => {}
                        }
                    }
                    cur = cur.tail;
                }
                let imp = HIRImpl::new(name, hir_methods);
                self.module.impl_list.push(imp);
            }
            ast::Stmt::Micro(name, args, body) => {
                let f = HIRFunc::new(name, args, body);
                self.module.funcs.push(f);
            }
            _ => {
                self.module.init_stmts.push(stmt);
            }
        }
    }
}
