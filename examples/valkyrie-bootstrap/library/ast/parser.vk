namespace package::parser;

using package::lexer
using package::ast

class Parser { lex, cur }

imply Parser {
  micro new(lex) {
    let p = new Parser
    p.lex = lex
    p.cur = p.lex.next_token()
    return p
  }
  micro advance(self) {
    self.cur = self.lex.next_token()
  }
  micro expect_semi(self) {
    let tag = self.cur.__variant__
    if tag == "Semi" {
        self.advance()
    } else {
    }
  }
  micro expect_rparen(self) {
    let tag = self.cur.__variant__
    if tag == "RParen" {
        self.advance()
    } else {
    }
  }
  micro parse_path(self) {
    let path = ""
    if self.cur.__variant__ == "Identifier" {
       path = self.cur._0
       self.advance()
       while self.cur.__variant__ == "Colon" {
          self.advance()
          if self.cur.__variant__ == "Colon" {
             self.advance()
             path = path + "::"
             if self.cur.__variant__ == "Identifier" {
                path = path + self.cur._0
                self.advance()
             }
          }
       }
    }
    return path
  }

  micro parse_fields(self) {
     let fields = new List
     if self.cur.__variant__ == "LBrace" {
        self.advance()
        while self.cur.__variant__ != "RBrace" && self.cur.__variant__ != "EOF" {
           if self.cur.__variant__ == "Identifier" {
              fields.push(self.cur._0)
              self.advance()
           }
           if self.cur.__variant__ == "Comma" {
              self.advance()
           }
        }
        if self.cur.__variant__ == "RBrace" { self.advance() }
     }
     return fields
  }

  micro parse_args(self) {
     let args = new List
     if self.cur.__variant__ == "LParen" {
        self.advance()
        while self.cur.__variant__ != "RParen" && self.cur.__variant__ != "EOF" {
           if self.cur.__variant__ == "Identifier" {
              args.push(self.cur._0)
              self.advance()
           }
           if self.cur.__variant__ == "Comma" {
              self.advance()
           }
        }
        if self.cur.__variant__ == "RParen" { self.advance() }
     }
     return args
  }

  micro parse_impl_body(self) {
     let methods = new List
     if self.cur.__variant__ == "LBrace" {
        self.advance()
        while self.cur.__variant__ != "RBrace" && self.cur.__variant__ != "EOF" {
           if self.cur.__variant__ == "KwMicro" {
              let m = self.parse_stmt()
              methods.push(m)
           } else {
              self.advance()
           }
        }
        if self.cur.__variant__ == "RBrace" { self.advance() }
     }
     return methods
  }

  micro parse_primary(self) {
    let tag = self.cur.__variant__
    if tag == "Integer" {
        let v = self.cur._0
        self.advance()
        return Expr::Int(v)
    } else {
        if tag == "String" {
            let v = self.cur._0
            self.advance()
            return Expr::String(v)
        } else {
            if tag == "KwTrue" {
                self.advance()
                return Expr::Bool(1)
            } else {
            if tag == "KwFalse" {
                self.advance()
                return Expr::Bool(0)
            } else {
            if tag == "Identifier" {
                let name = self.cur._0
                self.advance()
                return Expr::Variable(name)
            } else {
                if tag == "LParen" {
                    self.advance()
                    let e = self.parse_expr()
                    self.expect_rparen()
                    return e
                } else {
                    self.advance()
                    return Expr::Int(0)
                }
            }
            }
            }
        }
    }
  }
  micro parse_args_expr(self) {
     let args = new List
     if self.cur.__variant__ == "LParen" {
        self.advance()
        while self.cur.__variant__ != "RParen" && self.cur.__variant__ != "EOF" {
           let e = self.parse_expr()
           args.push(e)
           if self.cur.__variant__ == "Comma" {
              self.advance()
           }
        }
        if self.cur.__variant__ == "RParen" { self.advance() }
     }
     return args
  }

  micro parse_postfix(self) {
    let left = self.parse_primary()
    loop {
      let tag = self.cur.__variant__
      if tag == "Dot" {
         self.advance()
         if self.cur.__variant__ == "Identifier" {
            let name = self.cur._0
            self.advance()
            left = Expr::Field(left, name)
         }
      } else {
         if tag == "LParen" {
            let args = self.parse_args_expr()
            left = Expr::Call(left, args)
         } else {
            break
         }
      }
    }
    return left
  }

  micro parse_term(self) {
    let left = self.parse_postfix()
    loop {
      let tag = self.cur.__variant__
      if tag == "Star" {
          self.advance()
          let right = self.parse_primary()
          left = Expr::Mul(left, right)
      } else {
         if tag == "Slash" {
            self.advance()
            let right = self.parse_primary()
            left = Expr::Div(left, right)
         } else {
            break
         }
      }
    }
    return left
  }
  micro parse_add(self) {
    let left = self.parse_term()
    loop {
      let tag = self.cur.__variant__
      if tag == "Plus" {
          self.advance()
          let right = self.parse_term()
          left = Expr::Add(left, right)
      } else {
          if tag == "Minus" {
              self.advance()
              let right = self.parse_term()
              left = Expr::Sub(left, right)
          } else {
              break
          }
      }
    }
    return left
  }
  micro parse_expr(self) {
    let left = self.parse_add()
    loop {
      let tag = self.cur.__variant__
      if tag == "EqEq" {
        self.advance()
        let right = self.parse_add()
        left = Expr::Eq(left, right)
      } else {
        break
      }
    }
    return left
  }
  micro parse_decorators(self) {
     let acc = new List
     while self.cur.__variant__ == "At" {
        self.advance()
        let kind = "Macro"
        if self.cur.__variant__ == "Dot" {
           self.advance()
           kind = "Annotation"
        }
        let name = ""
        if self.cur.__variant__ == "Identifier" {
           name = self.cur._0
           self.advance()
        }
        let args = new List
        if self.cur.__variant__ == "LParen" {
           args = self.parse_args_expr()
        }
        let d = new Decorator
        d.kind = kind
        d.name = name
        d.args = args
        acc.push(d)
     }
     return acc
  }

  micro parse_stmt(self) {
    let tag = self.cur.__variant__
    
    if tag == "At" {
        let decorators = self.parse_decorators()
        let stmt = self.parse_stmt()
        return Stmt::Decorated(decorators, stmt)
    }

    if tag == "KwNamespace" {
        self.advance()
        let name = self.parse_path()
        self.expect_semi()
        return Stmt::Namespace(name)
    } else if tag == "KwUsing" {
        self.advance()
        let path = self.parse_path()
        self.expect_semi()
        return Stmt::Using(path)
    } else if tag == "KwClass" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let fields = self.parse_fields()
        return Stmt::Class(name, fields)
    } else if tag == "KwImply" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let methods = self.parse_impl_body()
        return Stmt::Imply(name, methods)
    } else if tag == "KwMicro" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let args = self.parse_args_typed()
        let body = self.parse_block()
        return Stmt::Micro(name, args, body)
    } else if tag == "KwMacro" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let args = self.parse_args_typed()
        let body = self.parse_block()
        return Stmt::Macro(name, args, body)
    } else if tag == "KwEnum" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let variants = self.parse_fields()
        return Stmt::Enum(name, variants)
    } else if tag == "KwLet" {
        self.advance()
        let t = self.cur.__variant__
        if t == "Identifier" {
            let name = self.cur._0
            self.advance()
            let ty = Parser::parse_optional_type(self)
            if self.cur.__variant__ == "Eq" { self.advance() }
            let val = self.parse_expr()
            self.expect_semi()
            return Stmt::Let(name, ty, val)
        } else {
            let v = self.parse_expr()
            self.expect_semi()
            return Stmt::Expr(v)
        }
    } else {
        if tag == "KwPrint" {
            self.advance()
            let t = self.cur.__variant__
            if t == "LParen" {
                self.advance()
                let e = self.parse_expr()
                self.expect_rparen()
                self.expect_semi()
                return Stmt::Print(e)
            } else {
                let e = self.parse_expr()
                self.expect_semi()
                return Stmt::Print(e)
            }
        } else {
            if tag == "KwIf" {
                self.advance()
                let cond = self.parse_expr()
                let then_branch = self.parse_stmt()
                let else_branch = Stmt::Block(new List)
                let tag2 = self.cur.__variant__
                if tag2 == "KwElse" {
                    self.advance()
                    else_branch = self.parse_stmt()
                }
                return Stmt::If(cond, then_branch, else_branch)
            } else if tag == "KwMatch" {
                self.advance()
                let scrutinee = self.parse_expr()
                let arms = Parser::parse_match_arms(self)
                return Stmt::Match(scrutinee, arms)
            } else {
                if tag == "KwWhile" {
                    self.advance()
                    let cond = self.parse_expr()
                    let body = self.parse_stmt()
                    return Stmt::While(cond, body)
                } else {
                    if tag == "KwReturn" {
                         self.advance()
                         let val = self.parse_expr()
                         self.expect_semi()
                         return Stmt::Return(val)
                    } else {
                        if tag == "LBrace" {
                            return self.parse_block()
                        } else {
                            let e = self.parse_expr()
                            self.expect_semi()
                            return Stmt::Expr(e)
                        }
                    }
                }
            }
        }
    }
  }
  micro parse_block(self) {
    self.advance()
    let acc = new List
    loop {
       let tag = self.cur.__variant__
       if tag == "RBrace" {
           self.advance()
           break
       } else {
           if tag == "EOF" {
               break
           } else {
               let s = self.parse_stmt()
               acc.push(s)
           }
       }
    }
    return Stmt::Block(acc)
  }
  micro parse_all(self) {
    let acc = new List
    loop {
      let tag = self.cur.__variant__
      if tag == "EOF" {
        break
      }
      let s = self.parse_stmt()
      acc.push(s)
    }
    return Stmt::Block(acc)
  }
  micro parse_type_primary(self) {
    if self.cur.__variant__ == "Identifier" {
      let path = self.parse_path()
      if self.cur.__variant__ == "LParen" {
        let args = Parser::parse_type_args(self)
        return Type::Apply(path, args)
      }
      return Type::Name(path)
    } else {
      if self.cur.__variant__ == "LParen" {
        self.advance()
        let elems = new List
        while self.cur.__variant__ != "RParen" && self.cur.__variant__ != "EOF" {
          let t = Parser::parse_type_expr(self)
          elems.push(t)
          if self.cur.__variant__ == "Comma" { self.advance() }
        }
        if self.cur.__variant__ == "RParen" { self.advance() }
        return Type::Tuple(elems)
      } else {
        return Type::Name("")
      }
    }
  }
  micro parse_type_args(self) {
    let args = new List
    if self.cur.__variant__ == "LParen" {
      self.advance()
      while self.cur.__variant__ != "RParen" && self.cur.__variant__ != "EOF" {
        if self.cur.__variant__ == "Identifier" {
          let save = self.cur._0
          self.advance()
          if self.cur.__variant__ == "Colon" {
            self.advance()
            let ty = Parser::parse_type_expr(self)
            args.push(TypeArg::Field(save, ty))
          } else {
            let ty = Type::Name(save)
            args.push(TypeArg::Ty(ty))
          }
        } else {
          if self.cur.__variant__ == "Integer" {
            let v = self.cur._0
            self.advance()
            args.push(TypeArg::Int(v))
          } else {
            let ty2 = Parser::parse_type_expr(self)
            args.push(TypeArg::Ty(ty2))
          }
        }
        if self.cur.__variant__ == "Comma" { self.advance() }
      }
      if self.cur.__variant__ == "RParen" { self.advance() }
    }
    return args
  }
  micro parse_type_expr(self) {
    let left = Parser::parse_type_primary(self)
    loop {
      if self.cur.__variant__ == "Question" {
        self.advance()
        left = Type::Nullable(left)
        continue
      }
      if self.cur.__variant__ == "Pipe" {
        self.advance()
        let right = Parser::parse_type_primary(self)
        left = Type::Union(left, right)
        continue
      }
      if self.cur.__variant__ == "Amp" {
        self.advance()
        let right = Parser::parse_type_primary(self)
        left = Type::Intersect(left, right)
        continue
      }
      break
    }
    return left
  }
  micro parse_optional_type(self) {
    if self.cur.__variant__ == "Colon" {
      self.advance()
      return Parser::parse_type_expr(self)
    }
    return Type::Name("")
  }
  micro parse_args_typed(self) {
    let args = new List
    if self.cur.__variant__ == "LParen" {
      self.advance()
      while self.cur.__variant__ != "RParen" && self.cur.__variant__ != "EOF" {
        let name = ""
        if self.cur.__variant__ == "Identifier" {
          name = self.cur._0
          self.advance()
        }
        let ty = Parser::parse_optional_type(self)
        let a = new Arg
        a.name = name
        a.type = ty
        args.push(a)
        if self.cur.__variant__ == "Comma" { self.advance() }
      }
      if self.cur.__variant__ == "RParen" { self.advance() }
    }
    return args
  }
  micro parse_pattern(self) {
    let tag = self.cur.__variant__
    if tag == "Identifier" {
      if self.cur._0 == "_" {
        self.advance()
        return Pattern::Wildcard(0)
      } else {
        let ty = Parser::parse_type_expr(self)
        return Pattern::Type(ty)
      }
    }
    if tag == "Integer" {
      let v = self.cur._0
      self.advance()
      return Pattern::Int(v)
    }
    if tag == "String" {
      let v = self.cur._0
      self.advance()
      return Pattern::String(v)
    }
    if tag == "KwTrue" {
      self.advance()
      return Pattern::Bool(1)
    }
    if tag == "KwFalse" {
      self.advance()
      return Pattern::Bool(0)
    }
    if tag == "LParen" {
      self.advance()
      let elems = new List
      while self.cur.__variant__ != "RParen" && self.cur.__variant__ != "EOF" {
        let p = Parser::parse_pattern(self)
        elems.push(p)
        if self.cur.__variant__ == "Comma" { self.advance() }
      }
      if self.cur.__variant__ == "RParen" { self.advance() }
      return Pattern::Tuple(elems)
    }
    return Pattern::Wildcard(0)
  }
  micro parse_match_arms(self) {
    let arms = new List
    if self.cur.__variant__ == "LBrace" {
      self.advance()
      while self.cur.__variant__ != "RBrace" && self.cur.__variant__ != "EOF" {
        let pat = Parser::parse_pattern(self)
        if self.cur.__variant__ == "Arrow" || self.cur.__variant__ == "Colon" {
          self.advance()
        }
        let body = self.parse_stmt()
        let arm = new MatchArm
        arm.pat = pat
        arm.body = body
        arms.push(arm)
        if self.cur.__variant__ == "Comma" { self.advance() }
      }
      if self.cur.__variant__ == "RBrace" { self.advance() }
    }
    return arms
  }
}
