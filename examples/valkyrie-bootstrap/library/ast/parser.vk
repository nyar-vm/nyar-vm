namespace package::parser;

using package::lexer
using package::ast

class Parser { lex, cur }

imply Parser {
  micro new(lex) {
    let p = new Parser
    p.lex = lex
    let l = p.lex
    let tok = l.next_token()
    p.cur = tok
    return p
  }
  micro advance(self) {
    self.cur = self.lex.next_token()
  }
  micro current_kind(self) {
    if self.cur {
        return self.cur.kind
    } else {
        print("DEBUG: current_kind self.cur is null")
        return TokenKind::EOF
    }
  }

  micro parse_all(self) {
    let stmts = new List
    let loop_count = 0
    while true {
      let t = self.current_kind()
      let variant = t.__variant__
      # print("DEBUG: parse_all loop " + str(loop_count) + " variant: " + variant)
      if loop_count > 5000 {
         print("DEBUG: parse_all loop " + str(loop_count) + " variant: " + variant)
      }
      if variant == "EOF" { break }
      let s = self.parse_stmt()
      stmts.push(s)
      loop_count = loop_count + 1
      if loop_count > 1000000 {
         print("ERROR: Infinite loop in parse_all?")
         break
      }
    }
    return stmts
  }
  micro expect_semi(self) {
    match self.current_kind() {
       case TokenKind::Semi:
            self.advance()
       case _:
    }
  }
  micro expect_rparen(self) {
    match self.current_kind() {
       case TokenKind::RParen:
            self.advance()
       case _:
    }
  }
  micro parse_path(self) {
    let path = ""
    if self.current_kind().__variant__ == "Identifier" {
       path = self.current_kind()._0
       self.advance()
       while self.current_kind().__variant__ == "Colon" {
          self.advance()
          if self.current_kind().__variant__ == "Colon" {
             self.advance()
             path = path + "::"
             if self.current_kind().__variant__ == "Identifier" {
                path = path + self.current_kind()._0
                self.advance()
             }
          }
       }
    }
    return path
  }

  micro parse_fields(self) {
     let fields = new List
     if self.current_kind().__variant__ == "LBrace" {
        self.advance()
        while self.current_kind().__variant__ != "RBrace" && self.current_kind().__variant__ != "EOF" {
           if self.current_kind().__variant__ == "Identifier" {
              fields.push(self.current_kind()._0)
              self.advance()
           }
           if self.current_kind().__variant__ == "Comma" {
              self.advance()
           }
        }
        if self.current_kind().__variant__ == "RBrace" { self.advance() }
     }
     return fields
  }

  micro parse_args(self) {
     let args = new List
     if self.current_kind().__variant__ == "LParen" {
        self.advance()
        while self.current_kind().__variant__ != "RParen" && self.current_kind().__variant__ != "EOF" {
           if self.current_kind().__variant__ == "Identifier" {
              args.push(self.current_kind()._0)
              self.advance()
           }
           if self.current_kind().__variant__ == "Comma" {
              self.advance()
           }
        }
        if self.current_kind().__variant__ == "RParen" { self.advance() }
     }
     return args
  }

  micro parse_impl_body(self) {
     let methods = new List
     if self.current_kind().__variant__ == "LBrace" {
        self.advance()
        while self.current_kind().__variant__ != "RBrace" && self.current_kind().__variant__ != "EOF" {
           if self.current_kind().__variant__ == "KwMicro" {
              let m = self.parse_stmt()
              methods.push(m)
           } else {
              self.advance()
           }
        }
        if self.current_kind().__variant__ == "RBrace" { self.advance() }
     }
     return methods
  }

  micro parse_primary(self) {
    let kind = self.current_kind()
    let span = self.cur.span
    match kind {
       case TokenKind::Integer(v):
          self.advance()
          return Expr::Int(v, span)
       case TokenKind::String(v):
          self.advance()
          return Expr::String(v, span)
       case TokenKind::KwTrue:
          self.advance()
          return Expr::Bool(1, span)
       case TokenKind::KwFalse:
          self.advance()
          return Expr::Bool(0, span)
       case TokenKind::Identifier(name):
          self.advance()
          return Expr::Variable(name, span)
       case TokenKind::LParen:
          self.advance()
          let e = self.parse_expr()
          self.expect_rparen()
          return e
       case _:
          self.advance()
          return Expr::Int(0, span)
    }
  }
  micro parse_args_expr(self) {
     let args = new List
     if self.current_kind().__variant__ == "LParen" {
        self.advance()
        while self.current_kind().__variant__ != "RParen" && self.current_kind().__variant__ != "EOF" {
           let e = self.parse_expr()
           args.push(e)
           if self.current_kind().__variant__ == "Comma" {
              self.advance()
           }
        }
        if self.current_kind().__variant__ == "RParen" { self.advance() }
     }
     return args
  }

  micro parse_postfix(self) {
    let left = self.parse_primary()
    loop {
      let tag = self.current_kind().__variant__
      let span = self.cur.span
      match tag {
         case "Dot":
             self.advance()
             if self.current_kind().__variant__ == "Identifier" {
                let name = self.current_kind()._0
                self.advance()
                left = Expr::Field(left, name, span)
             }
         case "LParen":
             let args = self.parse_args_expr()
             left = Expr::Call(left, args, span)
         case _:
            break
      }
    }
    return left
  }

  micro parse_term(self) {
    let left = self.parse_postfix()
    loop {
      let tag = self.current_kind().__variant__
      let span = self.cur.span
      match tag {
         case "Star":
             self.advance()
             let right = self.parse_primary()
             left = Expr::Mul(left, right, span)
         case "Slash":
             self.advance()
             let right = self.parse_primary()
             left = Expr::Div(left, right, span)
         case _:
            break
      }
    }
    return left
  }
  micro parse_add(self) {
    let left = self.parse_term()
    loop {
      let tag = self.current_kind().__variant__
      let span = self.cur.span
      match tag {
         case "Plus":
             self.advance()
             let right = self.parse_term()
             left = Expr::Add(left, right, span)
         case "Minus":
             self.advance()
             let right = self.parse_term()
             left = Expr::Sub(left, right, span)
         case _:
            break
      }
    }
    return left
  }
  micro parse_expr(self) {
    let left = self.parse_add()
    loop {
      let tag = self.current_kind().__variant__
      let span = self.cur.span
      match tag {
         case "EqEq":
             self.advance()
             let right = self.parse_add()
             left = Expr::Eq(left, right, span)
         case _:
            break
      }
    }
    return left
  }
  micro parse_decorators(self) {
     let acc = new List
     while self.current_kind().__variant__ == "At" {
        self.advance()
        let kind = "Macro"
        if self.current_kind().__variant__ == "Dot" {
           self.advance()
           kind = "Annotation"
        }
        let name = ""
        if self.current_kind().__variant__ == "Identifier" {
           name = self.current_kind()._0
           self.advance()
        }
        let args = new List
        if self.current_kind().__variant__ == "LParen" {
           args = self.parse_args_expr()
        }
        let d = new Decorator
        d.kind = kind
        d.name = name
        d.args = args
        acc.push(d)
     }
     return acc
  }

  micro parse_stmt(self) {
    let kind = self.current_kind()
    let variant = kind.__variant__
    # print("DEBUG: parse_stmt kind: " + variant)
    let span = null
    if self.cur {
        span = self.cur.span
    }
    match kind {
       case TokenKind::At:
           let decorators = self.parse_decorators()
           let stmt = self.parse_stmt()
           return Stmt::Decorated(decorators, stmt, span)
       case TokenKind::KwNamespace:
           self.advance()
           let name = self.parse_path()
           self.expect_semi()
           return Stmt::Namespace(name, span)
       case TokenKind::KwUsing:
           self.advance()
           let path = self.parse_path()
           self.expect_semi()
           return Stmt::Using(path, span)
       case TokenKind::KwClass:
           self.advance()
           let name = ""
           match self.current_kind() {
               case TokenKind::Identifier(n):
                   name = n
                   self.advance()
               case _:
           }
           let fields = self.parse_fields()
           return Stmt::Class(name, fields, span)
       case TokenKind::KwImply:
           self.advance()
           let name = ""
           match self.current_kind() {
               case TokenKind::Identifier(n):
                   name = n
                   self.advance()
               case _:
           }
           let methods = self.parse_impl_body()
           return Stmt::Imply(name, methods, span)
       case TokenKind::KwMicro:
           self.advance()
           let name = ""
           match self.current_kind() {
               case TokenKind::Identifier(n):
                   name = n
                   self.advance()
               case _:
           }
           let args = self.parse_args_typed()
           let body = self.parse_block()
           return Stmt::Micro(name, args, body, span)
       case TokenKind::KwMacro:
           self.advance()
           let name = ""
           match self.current_kind() {
               case TokenKind::Identifier(n):
                   name = n
                   self.advance()
               case _:
           }
           let args = self.parse_args_typed()
           let body = self.parse_block()
           return Stmt::Macro(name, args, body, span)
       case TokenKind::KwEnum:
           self.advance()
           let name = ""
           match self.current_kind() {
               case TokenKind::Identifier(n):
                   name = n
                   self.advance()
               case _:
           }
           let variants = self.parse_fields()
           return Stmt::Enum(name, variants, span)
       case TokenKind::KwLet:
           self.advance()
           match self.current_kind() {
               case TokenKind::Identifier(name):
                   self.advance()
                   let ty = Parser::parse_optional_type(self)
                   match self.current_kind() {
                       case TokenKind::Eq:
                           self.advance()
                       case _:
                   }
                   let val = self.parse_expr()
                   self.expect_semi()
                   return Stmt::Let(name, ty, val, span)
               case _:
                   let v = self.parse_expr()
                   self.expect_semi()
                   return Stmt::Expr(v, span)
           }
       case TokenKind::KwPrint:
           self.advance()
           match self.current_kind() {
               case TokenKind::LParen:
                   self.advance()
                   let e = self.parse_expr()
                   self.expect_rparen()
                   self.expect_semi()
                   return Stmt::Print(e, span)
               case _:
                   let e = self.parse_expr()
                   self.expect_semi()
                   return Stmt::Print(e, span)
           }
       case TokenKind::KwIf:
           self.advance()
           let cond = self.parse_expr()
           let then_branch = self.parse_stmt()
           let else_branch = Stmt::Block(new List, span)
           match self.current_kind() {
               case TokenKind::KwElse:
                   self.advance()
                   else_branch = self.parse_stmt()
               case _:
           }
           return Stmt::If(cond, then_branch, else_branch, span)
       case TokenKind::KwMatch:
           self.advance()
           let scrutinee = self.parse_expr()
           let arms = Parser::parse_match_arms(self)
           return Stmt::Match(scrutinee, arms, span)
       case TokenKind::KwWhile:
           self.advance()
           let cond = self.parse_expr()
           let body = self.parse_stmt()
           return Stmt::While(cond, body, span)
       case TokenKind::KwReturn:
            self.advance()
            let val = self.parse_expr()
            self.expect_semi()
            return Stmt::Return(val, span)
       case TokenKind::LBrace: 
           return self.parse_block()
       case _:
           let e = self.parse_expr()
           self.expect_semi()
           return Stmt::Expr(e, span)
    }
  }
  micro parse_block(self) {
    let span = self.cur.span
    self.advance()
    let acc = new List
    loop {
       let tag = self.current_kind().__variant__
       match tag {
           case "RBrace":
               self.advance()
               break
           case "EOF":
               break
           case _:
               let s = self.parse_stmt()
               acc.push(s)
       }
    }
    return Stmt::Block(acc, span)
  }
  micro parse_case_block(self) {
    let span = self.cur.span
    let acc = new List
    loop {
       let tag = self.current_kind().__variant__
       match tag {
           case "KwCase":
               break
           case "KwElse":
               break
           case "RBrace":
               break
           case "EOF":
               break
           case _:
               let s = self.parse_stmt()
               acc.push(s)
       }
    }
    return Stmt::Block(acc, span)
  }
  micro parse_type_primary(self) {
    let kind = self.current_kind()
    let span = self.cur.span
    match kind {
        case TokenKind::Identifier(path):
            let path_str = self.parse_path()
            match self.current_kind() {
                case TokenKind::LParen:
                    let args = Parser::parse_type_args(self)
                    return Type::Apply(path_str, args, span)
                case _:
                    let ty = Type::Name(path_str, span)
                    return ty
            }
            return Type::Name(path_str, span)
        case TokenKind::LParen:
            self.advance()
            match self.current_kind() {
                case TokenKind::RParen:
                    self.advance()
                    return Type::Unit(0, span)
                case _:
            }
            let elems = new List
            while self.current_kind().__variant__ != "RParen" && self.current_kind().__variant__ != "EOF" {
                let t = Parser::parse_type_expr(self)
                elems.push(t)
                if self.current_kind().__variant__ == "Comma" { self.advance() }
            }
            if self.current_kind().__variant__ == "RParen" { self.advance() }
            if elems.len() == 1 {
                return elems.get(0)
            }
            return Type::Tuple(elems, span)
        }
        case _:
            return Type::Name("", span)
    }
  }
  micro parse_type_args(self) {
    let args = new List
    if self.current_kind().__variant__ == "LParen" {
      self.advance()
      while self.current_kind().__variant__ != "RParen" && self.current_kind().__variant__ != "EOF" {
        let kind = self.current_kind()
        let span = self.cur.span
        match kind {
            case TokenKind::Identifier(save):
                self.advance()
                match self.current_kind() {
                    case TokenKind::Colon:
                        self.advance()
                        let ty = Parser::parse_type_expr(self)
                        args.push(TypeArg::Field(save, ty, span))
                    else:
                        let ty = Type::Name(save, span)
                        args.push(TypeArg::Ty(ty, span))
                }
            }
            case TokenKind::Integer(v):
                self.advance()
                args.push(TypeArg::Int(v, span))
            else:
                let ty2 = Parser::parse_type_expr(self)
                args.push(TypeArg::Ty(ty2, span))
        }
        if self.current_kind().__variant__ == "Comma" { self.advance() }
      }
      if self.current_kind().__variant__ == "RParen" { self.advance() }
    }
    return args
  }
  micro parse_type_bp(self, min_bp) {
     let left = self.parse_type_primary()
     
     loop {
        let kind = self.current_kind()
        let span = self.cur.span
        
        # Postfix operators (Highest binding power)
        match kind {
            case TokenKind::Question:
               self.advance()
               left = Type::Nullable(left, span)
               continue
            case _:
        }
        
        # Infix operators
        let lbp = 0
        let rbp = 0
        
        match kind {
            case TokenKind::Amp:
               lbp = 60
               rbp = 61
            case TokenKind::Pipe:
               lbp = 50
               rbp = 51
            case TokenKind::Arrow:
               lbp = 40
               rbp = 41
            case _:
               break
        }
        
        if lbp < min_bp {
           break
        }
        
        self.advance()
        let right = self.parse_type_bp(rbp)
        
        match kind {
            case TokenKind::Amp:
               left = Type::Intersect(left, right, span)
            case TokenKind::Pipe:
               left = Type::Union(left, right, span)
            case TokenKind::Arrow:
               # Function type support: A -> B
               # Convert left to args list if not already
               let args = new List
               args.push(left)
               left = Type::Function(args, right, span)
            case _:
        }
     }
     return left
  }

  micro parse_type_expr(self) {
    return self.parse_type_bp(0)
  }

  micro parse_optional_type(self) {
    let span = self.cur.span
    match self.current_kind() {
        case TokenKind::Colon:
          self.advance()
          return Parser::parse_type_expr(self)
        case _:
    }
    return Type::Name("", span)
  }
  micro parse_args_typed(self) {
    let args = new List
    match self.current_kind() {
        case TokenKind::LParen:
          self.advance()
          while self.current_kind().__variant__ != "RParen" && self.current_kind().__variant__ != "EOF" {
            let name = ""
            let span = self.cur.span
            match self.current_kind() {
                case TokenKind::Identifier(n):
                  name = n
                  self.advance()
                case _:
            }
            let ty = Parser::parse_optional_type(self)
            let a = new Arg
            a.name = name
            a.type = ty
            a.span = span
            args.push(a)
            if self.current_kind().__variant__ == "Comma" { self.advance() }
          }
          if self.current_kind().__variant__ == "RParen" { self.advance() }
        case _:
    }
    return args
  }
  micro parse_pattern(self) {
    let kind = self.current_kind()
    let span = self.cur.span
    match kind {
        case TokenKind::Identifier(name):
            if name == "_" {
                self.advance()
                return Pattern::Wildcard(0, span)
            } else {
                self.advance()
                match self.current_kind() {
                    case TokenKind::LParen:
                        let args = self.parse_pattern_tuple()
                        return Pattern::Variant(name, args, span)
                    case _:
                }
                return Pattern::Type(Type::Name(name, span), span)
            }
        }
        case TokenKind::Integer(v):
            self.advance()
            return Pattern::Int(v, span)
        case TokenKind::String(v):
            self.advance()
            return Pattern::String(v, span)
        case TokenKind::KwTrue:
            self.advance()
            return Pattern::Bool(1, span)
        case TokenKind::KwFalse:
            self.advance()
            return Pattern::Bool(0, span)
        case TokenKind::LParen:
            let elems = self.parse_pattern_tuple()
            return Pattern::Tuple(elems, span)
        case _:
            return Pattern::Wildcard(0, span)
    }
  }

  micro parse_pattern_tuple(self) {
      self.advance()
      let elems = new List
      while self.current_kind().__variant__ != "RParen" && self.current_kind().__variant__ != "EOF" {
        let p = Parser::parse_pattern(self)
        elems.push(p)
        match self.current_kind() {
            case TokenKind::Comma:
                self.advance()
            case _:
        }
      }
      match self.current_kind() {
          case TokenKind::RParen:
                self.advance()
          case _:
      }
      return elems
  }

  micro parse_match_arms(self) {
    let arms = new List
    match self.current_kind() {
        case TokenKind::LBrace:
          self.advance()
          while self.current_kind().__variant__ != "RBrace" && self.current_kind().__variant__ != "EOF" {
            let span = self.cur.span
            let pat = Pattern::Wildcard(0, span)
            match self.current_kind() {
               case TokenKind::KwCase:
                    self.advance()
                    let p2 = Parser::parse_pattern(self)
                    pat = p2
               case TokenKind::KwElse:
                    self.advance()
               case _:
            }
            match self.current_kind() {
                case TokenKind::Colon:
                    self.advance()
                case _:
            }
            let body = self.parse_case_block()
            let arm = new MatchArm
            arm.pat = pat
            arm.body = body
            arm.span = span
            arms.push(arm)
            # Optional comma? User example didn't show comma, but previous code had it.
            # Assuming comma might be optional or not present in new syntax, but let's keep it optional for robust parsing if needed, 
            # OR remove it if new syntax relies on 'case' keyword as separator.
            # The 'case' keyword acts as a separator, so comma is not strictly needed.
            # But let's check if there is a comma and consume it if so.
            match self.current_kind() {
                case TokenKind::Comma:
                    self.advance()
                case _:
            }
          }
          match self.current_kind() {
              case TokenKind::RBrace:
                    self.advance()
              case _:
          }
        }
        case _:
    }
    return arms
  }
}
