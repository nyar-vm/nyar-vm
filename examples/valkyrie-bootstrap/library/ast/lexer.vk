namespace package::lexer;

enum TokenKind {
  EOF,
  Identifier(name),
  String(content),
  Integer(literal),
  KwTrue,
  KwFalse,
  Plus,
  Minus,
  Star,
  Slash,
  LParen,
  RParen,
  LBrace,
  RBrace,
  Eq,
  EqEq,
  Arrow,
  Semi,
  KwLet,
  KwPrint,
  KwIf,
  KwElse,
  KwWhile,
  KwMicro,
  KwMacro,
  KwClass,
  KwEnum,
  KwReturn,
  KwNamespace,
  KwUsing,
  KwImply,
  Comma,
  Colon,
  Pipe,
  Amp,
  Question,
  At,
  Dot,
  KwMatch,
  KwCase
}

class Span { file, start, end, line, col }
class Token { kind, span }

class Lexer { input, pos, len, ch, line, col }

imply Lexer {
  micro new(input) {
    print("DEBUG: Lexer::new start")
    let l = new Lexer
    print("DEBUG: Lexer object allocated")
    l.input = input
    print("DEBUG: using input string directly")
    if l.input {
        print("DEBUG: l.input is valid")
        l.len = len(l.input)
        print("DEBUG: l.len raw: ")
        print(l.len)
        print("DEBUG: l.len calculated: " + str(l.len))
    } else {
        print("DEBUG: l.input is null!")
        l.len = 0
    }
    l.pos = 0
    l.ch = "\0"
    l.line = 1
    l.col = 1
    print("DEBUG: calling l.read_char() in new")
    if l {
       print("DEBUG: l is valid")
    }
    l.read_char()
    print("DEBUG: Lexer::new returning")
    print("DEBUG: Lexer pos inside new: " + l.pos)
    if l is Lexer {
        print("DEBUG: l is Lexer")
    } else {
        print("DEBUG: l is NOT Lexer")
    }
    print("DEBUG: Lexer::new returning type: " + str(typeof(l)))
    let test_tok = TokenKind::Identifier("test")
    print("DEBUG: TokenKind::Identifier('test') variant: " + test_tok.__variant__)
    return l
  }
  micro read_char(self) {
      if self.pos >= self.len {
        self.ch = ""
      } else {
        let c = get(self.input, self.pos)
        self.ch = c
        if self.ch == null {
           self.ch = ""
        }
      }
      self.pos = self.pos + 1
      if self.ch == "\n" {
         self.line = self.line + 1
         self.col = 1
      } else {
         self.col = self.col + 1
      }
    }

  micro peek_char(self) {
    if self.pos >= self.len {
      return ""
    } else {
      return get(self.input, self.pos)
    }
  }

  micro is_eof(self) {
    return self.ch == ""
  }

  micro is_digit(c) {
    let o = ord(c)
    return o >= 48 && o <= 57
  }

  micro is_alpha(c) {
    let o = ord(c)
    return (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95
  }

  micro read_identifier(self) {
    let c = self.ch
    let s = ""
    s = s + c
    while Lexer::is_alpha(self.peek_char()) || Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro read_number(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro skip_whitespace(self) {
    while self.ch == " " || self.ch == "\t" || self.ch == "\n" || self.ch == "\r" {
      self.read_char()
    }
  }

  micro next_token(self) {
    loop {
      self.skip_whitespace()
      if self.ch == "#" {
        self.skip_comment()
        continue
      }
      break
    }
    
    let start_pos = self.pos
    let start_line = self.line
    let start_col = self.col
    
    let kind = self._next_token_impl()
    
    let span = new Span
    span.start = start_pos
    span.end = self.pos
    span.line = start_line
    span.col = start_col
    
    let tok = new Token
    tok.kind = kind
    tok.span = span
    return tok
  }

  micro _next_token_impl(self) {
    if self.ch == null {
        self.ch = ""
    }
    let c = self.ch
    if c == "(" {
          self.read_char()
          return TokenKind::LParen
     }
     
     if c == "\"" {
            let s = self.read_string()
            return TokenKind::String(s)
     } else {
       if c == "+" { self.read_char(); return TokenKind::Plus }
       else {
       if c == "-" { 
            self.read_char()
            if self.ch == ">" {
                self.read_char()
                return TokenKind::Arrow
            }
            return TokenKind::Minus 
       } else {
       if c == "*" { self.read_char(); return TokenKind::Star }
       else {
       if c == "/" { self.read_char(); return TokenKind::Slash }
       else {
       if c == "(" { self.read_char(); return TokenKind::LParen }
       else {
       if c == ")" { self.read_char(); return TokenKind::RParen }
       else {
       if c == "{" { self.read_char(); return TokenKind::LBrace }
       else {
       if c == "}" { self.read_char(); return TokenKind::RBrace }
       else {
       if c == "=" { 
            self.read_char()
            if self.ch == "=" {
                self.read_char()
                return TokenKind::EqEq
            }
            return TokenKind::Eq 
       } else {
       if c == ";" { self.read_char(); return TokenKind::Semi }
       else {
       if c == "," { self.read_char(); return TokenKind::Comma }
       else {
       if c == ":" { self.read_char(); return TokenKind::Colon }
       else {
       if c == "|" { self.read_char(); return TokenKind::Pipe }
       else {
       if c == "&" { self.read_char(); return TokenKind::Amp }
       else {
       if c == "?" { self.read_char(); return TokenKind::Question }
       else {
       if c == "@" { self.read_char(); return TokenKind::At }
       else {
       if c == "." { self.read_char(); return TokenKind::Dot }
       else {
           if Lexer::is_alpha(c) {
             let lit = self.read_identifier()
             
             # match lit replacement
             # print("DEBUG: lit='" + lit + "' len=" + str(len(lit)))
             
             if lit == "let" { return TokenKind::KwLet }
             else {
             if lit == "print" { return TokenKind::KwPrint }
             else {
             if lit == "if" { return TokenKind::KwIf }
             else {
             if lit == "else" { return TokenKind::KwElse }
             else {
             if lit == "while" { return TokenKind::KwWhile }
             else {
             if lit == "micro" { return TokenKind::KwMicro }
             else {
             if lit == "macro" { return TokenKind::KwMacro }
             else {
             if lit == "class" { return TokenKind::KwClass }
             else {
             if lit == "enum" { return TokenKind::KwEnum }
             else {
             if lit == "return" { return TokenKind::KwReturn }
             else {
             if lit == "namespace" { return TokenKind::KwNamespace }
             else {
             if lit == "using" { return TokenKind::KwUsing }
             else {
             if lit == "imply" { return TokenKind::KwImply }
             else {
             if lit == "match" { return TokenKind::KwMatch }
             else {
             if lit == "case" { return TokenKind::KwCase }
             else {
             if lit == "true" { return TokenKind::KwTrue }
             else {
             if lit == "false" { return TokenKind::KwFalse }
             else {
                  let res = TokenKind::Identifier(lit)
                  # print("DEBUG: returning token kind variant: " + res.__variant__)
                  return res
             }}}}}}}}}}}}}}}}}
           } else {
             if Lexer::is_digit(c) {
                let num = self.read_number()
                return TokenKind::Integer(num)
             } else {
                print("DEBUG: skipping self.read_char() in else block to test")
                # self.read_char()
                return TokenKind::Identifier(c)
             }
           }
       }}}}}}}}}}}}}}}}}}
   }
   micro skip_comment(self) {
    while self.ch != "\n" && self.ch != "\r" && self.ch != "" {
      self.read_char()
    }
  }
  micro read_string(self) {
    print("DEBUG: inside read_string")
    let t = typeof(self)
    print("DEBUG: typeof(self) in read_string = " + str(t))
    self.read_char()
    let s = ""
    while self.ch != "\"" && self.ch != "" {
      s = s + self.ch
      self.read_char()
    }
    return s
  }
}
