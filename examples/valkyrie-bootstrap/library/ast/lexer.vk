namespace package::lexer;

enum TokenKind {
  EOF,
  Identifier(name),
  String(content),
  Integer(literal),
  KwTrue,
  KwFalse,
  Plus,
  Minus,
  Star,
  Slash,
  LParen,
  RParen,
  LBrace,
  RBrace,
  Eq,
  EqEq,
  Arrow,
  Semi,
  KwLet,
  KwIf,
  KwElse,
  KwWhile,
  KwMicro,
  KwMacro,
  KwClass,
  KwEnum,
  KwReturn,
  KwNamespace,
  KwUsing,
  KwImply,
  Comma,
  Colon,
  Pipe,
  Amp,
  Question,
  At,
  Dot,
  KwMatch,
  KwCase
}

class Span { file, start, end, line, col }
class Token { kind, span }

class Lexer { input, pos, len, ch, line, col }

imply Lexer {
  micro new(input) {
    let l = new Lexer
    l.input = input
    if l.input {
        l.len = len(l.input)
    } else {
        l.len = 0
    }
    l.pos = 0
    l.ch = "\0"
    l.line = 1
    l.col = 1
    l.read_char()
    return l
  }
  micro read_char(self) {
      if self.pos >= self.len {
        self.ch = ""
      } else {
        let c = get(self.input, self.pos)
        self.ch = c
        if self.ch == null {
           self.ch = ""
        }
      }
      self.pos = self.pos + 1
      if self.ch == "\n" {
         self.line = self.line + 1
         self.col = 1
      } else {
         self.col = self.col + 1
      }
    }

  micro peek_char(self) {
    if self.pos >= self.len {
      return ""
    } else {
      return get(self.input, self.pos)
    }
  }

  micro is_eof(self) {
    return self.ch == ""
  }

  micro is_digit(c) {
    let o = ord(c)
    return o >= 48 && o <= 57
  }

  micro is_alpha(c) {
    let o = ord(c)
    return (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95
  }

  micro read_identifier(self) {
    let c = self.ch
    let s = ""
    s = s + c
    while Lexer::is_alpha(self.peek_char()) || Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro read_number(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro skip_whitespace(self) {
    while self.ch == " " || self.ch == "\t" || self.ch == "\n" || self.ch == "\r" {
      self.read_char()
    }
  }

  micro next_token(self) {
    loop {
      self.skip_whitespace()
      if self.ch == "#" {
        self.skip_comment()
        continue
      }
      break
    }
    
    let start_pos = self.pos
    let start_line = self.line
    let start_col = self.col
    
    let kind = self._next_token_impl()
    
    let span = new Span
    span.start = start_pos
    span.end = self.pos
    span.line = start_line
    span.col = start_col
    
    let tok = new Token
    tok.kind = kind
    tok.span = span
    return tok
  }

  micro _next_token_impl(self) {
    if self.ch == null {
        self.ch = ""
    }
    let c = self.ch
    if c == "" { return TokenKind::EOF }
    
    if c == "(" {
          self.read_char()
          return TokenKind::LParen
     }
     
     if c == "\"" {
            let s = self.read_string()
            return TokenKind::String(s)
     } else {
       if c == "+" { self.read_char(); return TokenKind::Plus }
       else {
       if c == "-" { 
            self.read_char()
            if self.ch == ">" {
                self.read_char()
                return TokenKind::Arrow
            }
            return TokenKind::Minus 
       } else {
       if c == "*" { self.read_char(); return TokenKind::Star }
       else {
       if c == "/" { self.read_char(); return TokenKind::Slash }
       else {
       if c == "(" { self.read_char(); return TokenKind::LParen }
       else {
       if c == ")" { self.read_char(); return TokenKind::RParen }
       else {
       if c == "{" { self.read_char(); return TokenKind::LBrace }
       else {
       if c == "}" { self.read_char(); return TokenKind::RBrace }
       else {
       if c == "=" { 
            self.read_char()
            if self.ch == "=" {
                self.read_char()
                return TokenKind::EqEq
            }
            return TokenKind::Eq 
       } else {
       if c == ";" { self.read_char(); return TokenKind::Semi }
       else {
       if c == "," { self.read_char(); return TokenKind::Comma }
       else {
       if c == ":" { self.read_char(); return TokenKind::Colon }
       else {
       if c == "|" { self.read_char(); return TokenKind::Pipe }
       else {
       if c == "&" { self.read_char(); return TokenKind::Amp }
       else {
       if c == "?" { self.read_char(); return TokenKind::Question }
       else {
       if c == "@" { self.read_char(); return TokenKind::At }
       else {
       if c == "." { self.read_char(); return TokenKind::Dot }
       else {
           if Lexer::is_alpha(c) {
             let lit = self.read_identifier()
              match lit {
                 case "let":
                    return TokenKind::KwLet
                 case "if":
                    return TokenKind::KwIf
                 case "else":
                    return TokenKind::KwElse
                 case "while":
                    return TokenKind::KwWhile
                 case "micro":
                    return TokenKind::KwMicro
                 case "macro":
                    return TokenKind::KwMacro
                 case "class":
                    return TokenKind::KwClass
                 case "enum":
                    return TokenKind::KwEnum
                 case "return":
                    return TokenKind::KwReturn
                 case "namespace":
                    return TokenKind::KwNamespace
                 case "using":
                    return TokenKind::KwUsing
                 case "imply":
                    return TokenKind::KwImply
                 case "match":
                    return TokenKind::KwMatch
                 case "case":
                    return TokenKind::KwCase
                 case "true":
                    return TokenKind::KwTrue
                 case "false":
                    return TokenKind::KwFalse
                 case _:
                    let res = TokenKind::Identifier(lit)
                    return res
              }
           } else {
             if Lexer::is_digit(c) {
                let num = self.read_number()
                return TokenKind::Integer(num)
             } else {
                self.read_char()
                return TokenKind::Identifier(c)
             }
           }
       }}}}}}}}}}}}}}}}}}
   }
   micro skip_comment(self) {
    while self.ch != "\n" && self.ch != "\r" && self.ch != "" {
      self.read_char()
    }
  }
  micro read_string(self) {
    self.read_char()
    let s = ""
    while self.ch != "\"" && self.ch != "" {
      s = s + self.ch
      self.read_char()
    }
    return s
  }
}
