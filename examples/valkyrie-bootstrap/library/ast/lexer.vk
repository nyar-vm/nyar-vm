namespace package::lexer;

enum TokenKind {
  EOF,
  Identifier(name),
  String(content),
  Integer(literal),
  KwTrue,
  KwFalse,
  Plus,
  Minus,
  Star,
  Slash,
  LParen,
  RParen,
  LBrace,
  RBrace,
  Eq,
  EqEq,
  Arrow,
  Semi,
  KwLet,
  KwPrint,
  KwIf,
  KwElse,
  KwWhile,
  KwMicro,
  KwMacro,
  KwClass,
  KwEnum,
  KwReturn,
  KwNamespace,
  KwUsing,
  KwImply,
  Comma,
  Colon,
  Pipe,
  Amp,
  Question,
  At,
  Dot,
  KwMatch,
  KwCase
}

class Span { file, start, end, line, col }
class Token { kind, span }

class Lexer { input, pos, len, ch, line, col }

imply Lexer {
  micro new(input) {
    print("DEBUG: Lexer::new start")
    let l = new Lexer
    print("DEBUG: Lexer object allocated")
    l.input = input
    print("DEBUG: using input string directly")
    if l.input {
        print("DEBUG: l.input is valid")
        l.len = len(l.input)
        print("DEBUG: l.len raw: ")
        print(l.len)
        print("DEBUG: l.len calculated: " + str(l.len))
    } else {
        print("DEBUG: l.input is null!")
        l.len = 0
    }
    l.pos = 0
    l.ch = "\0"
    l.line = 1
    l.col = 1
    l.read_char()
    print("DEBUG: Lexer::new returning")
    print("DEBUG: Lexer pos inside new: " + l.pos)
    if l is Lexer {
        print("DEBUG: l is Lexer")
    } else {
        print("DEBUG: l is NOT Lexer")
    }
    return l
  }
  micro read_char(self) {
      if self.pos >= self.len {
        self.ch = ""
      } else {
        let c = get(self.input, self.pos)
        print("DEBUG: read_char get(" + str(self.pos) + ") returned: '" + str(c) + "'")
        self.ch = c
        if self.ch == null {
           print("DEBUG: read_char got null. pos=" + str(self.pos) + ", len=" + str(self.len))
           self.ch = ""
        }
      }
      self.pos = self.pos + 1
      if self.ch == "\n" {
         self.line = self.line + 1
         self.col = 1
      } else {
         self.col = self.col + 1
      }
    }

  micro peek_char(self) {
    if self.pos >= self.len {
      return ""
    } else {
      return get(self.input, self.pos)
    }
  }

  micro is_eof(self) {
    return self.ch == ""
  }

  micro is_digit(c) {
    let o = ord(c)
    return o >= 48 && o <= 57
  }

  micro is_alpha(c) {
    let o = ord(c)
    return (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95
  }

  micro read_identifier(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_alpha(self.peek_char()) || Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro read_number(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro skip_whitespace(self) {
    print("DEBUG: inside skip_whitespace")
    print(self)
    if self.ch == " " {
        print("DEBUG: if self.ch works")
    }
    while self.ch == " " || self.ch == "\t" || self.ch == "\n" || self.ch == "\r" {
      self.read_char()
    }
  }

  micro next_token(self) {
    print("DEBUG: inside next_token, checking self")
    print(self)
    loop {
      print("DEBUG: inside loop, checking self")
      print(self)
      self.skip_whitespace()
      if self.ch == "#" {
        self.skip_comment()
        continue
      }
      break
    }
    print("DEBUG: after loop")
    print(self)
    let start_pos = self.pos
    let start_line = self.line
    let start_col = self.col
    
    let kind = self._next_token_impl()
    
    let span = new Span
    span.start = start_pos
    span.end = self.pos
    span.line = start_line
    span.col = start_col
    
    let tok = new Token
    tok.kind = kind
    tok.span = span
    return tok
  }

  micro _next_token_impl(self) {
    print("DEBUG: inside _next_token_impl")
    print(self)
    if self.ch == null {
        print("DEBUG: self.ch is null in _next_token_impl, fixing it")
        self.ch = ""
    }
    let c = self.ch
    print("DEBUG: c is " + c)
    match c {
       case "": { return TokenKind::EOF }
       case "+": { self.read_char(); return TokenKind::Plus }
       case "-": { self.read_char(); return TokenKind::Minus }
       case "*": { self.read_char(); return TokenKind::Star }
       case "/": { self.read_char(); return TokenKind::Slash }
       case "(": { self.read_char(); return TokenKind::LParen }
       case ")": { self.read_char(); return TokenKind::RParen }
       case "{": { self.read_char(); return TokenKind::LBrace }
       case "}": { self.read_char(); return TokenKind::RBrace }
       case ",": { self.read_char(); return TokenKind::Comma }
       case ":": { self.read_char(); return TokenKind::Colon }
       case "|": { self.read_char(); return TokenKind::Pipe }
       case "&": { self.read_char(); return TokenKind::Amp }
       case "?": { self.read_char(); return TokenKind::Question }
       case "@": { self.read_char(); return TokenKind::At }
       case ".": { self.read_char(); return TokenKind::Dot }
       case ";": { self.read_char(); return TokenKind::Semi }
       case "=": {
          let p = self.peek_char()
          if p == "=" {
             self.read_char(); self.read_char()
             return TokenKind::EqEq
          } else if p == ">" {
             self.read_char(); self.read_char()
             return TokenKind::Arrow
          } else {
             self.read_char()
             return TokenKind::Eq
          }
       }
       case "\"": {
          let s = self.read_string()
          self.read_char()
          return TokenKind::String(s)
       }
       case _: {
          print("DEBUG: inside case _")
          print("DEBUG: c is " + c)
          if self {
             print("DEBUG: self is valid in case _")
          } else {
             print("DEBUG: self is NULL in case _")
          }
          if Lexer::is_alpha(c) {
             let lit = self.read_identifier()
             match lit {
                case "let": { return TokenKind::KwLet }
                case "print": { return TokenKind::KwPrint }
                case "if": { return TokenKind::KwIf }
                case "else": { return TokenKind::KwElse }
                case "while": { return TokenKind::KwWhile }
                case "micro": { return TokenKind::KwMicro }
                case "macro": { return TokenKind::KwMacro }
                case "class": { return TokenKind::KwClass }
                case "enum": { return TokenKind::KwEnum }
                case "return": { return TokenKind::KwReturn }
                case "namespace": { return TokenKind::KwNamespace }
                case "using": { return TokenKind::KwUsing }
                case "imply": { return TokenKind::KwImply }
                case "match": { return TokenKind::KwMatch }
                case "case": { return TokenKind::KwCase }
                case "true": { return TokenKind::KwTrue }
                case "false": { return TokenKind::KwFalse }
                case _: { return TokenKind::Identifier(lit) }
             }
          } else {
             if Lexer::is_digit(c) {
                let num = self.read_number()
                return TokenKind::Integer(num)
             } else {
                self.read_char()
                return TokenKind::Identifier(c)
             }
          }
       }
    }
  }
  micro skip_comment(self) {
    while self.ch != "\n" && self.ch != "\r" && self.ch != "" {
      self.read_char()
    }
  }
  micro read_string(self) {
    self.read_char()
    let s = ""
    while self.ch != "\"" && self.ch != "" {
      s = s + self.ch
      self.read_char()
    }
    return s
  }
}
