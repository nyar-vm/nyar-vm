namespace package::lexer;

enum TokenKind {
  EOF,
  Identifier(name),
  String(content),
  Integer(literal),
  KwTrue,
  KwFalse,
  Plus,
  Minus,
  Star,
  Slash,
  LParen,
  RParen,
  LBracket,
  RBracket,
  LBrace,
  RBrace,
  Eq,
  EqEq,
  Arrow,
  Semi,
  KwLet,
  KwIf,
  KwElse,
  KwWhile,
  KwMicro,
  KwMacro,
  KwClass,
  KwEnum,
  KwReturn,
  KwNamespace,
  KwUsing,
  KwImply,
  Comma,
  Colon,
  Pipe,
  Amp,
  Question,
  At,
  Dot,
  KwMatch,
  KwCase
}

class Span { file, start, end, line, col }
class Token { kind, span }

class Lexer { input, pos, len, ch, line, col }

class TokenHelper { __variant__, _0 }
micro _tk(v) {
    print("DEBUG: _tk entered v=" + v)
    let t = new TokenHelper
    t.__variant__ = v
    return t
}
micro _tk1(v, a) {
    let t = new TokenHelper
    t.__variant__ = v
    t._0 = a
    return t
}

imply Lexer {
  micro new(input) {
    print("DEBUG: Lexer::new entered")
    let l = new Lexer
    l.input = input
    if l.input {
        l.len = len(l.input)
    } else {
        l.len = 0
    }
    l.pos = 0
    l.ch = "\0"
    l.line = 1
    l.col = 1
    l.read_char()
    print("DEBUG: Lexer::new finished")
    return l
  }
  micro read_char(self) {
      # print("DEBUG: read_char pos=" + str(self.pos))
      if self.pos >= self.len {
        self.ch = ""
      } else {
        let c = get(self.input, self.pos)
        self.ch = c
        if self.ch == null {
           self.ch = ""
        }
      }
      self.pos = self.pos + 1
      if self.ch == "\n" {
         self.line = self.line + 1
         self.col = 1
      } else {
         self.col = self.col + 1
      }
    }

  micro peek_char(self) {
    if self.pos >= self.len {
      return ""
    } else {
      return get(self.input, self.pos)
    }
  }

  micro is_eof(self) {
    return self.ch == ""
  }

  micro is_digit(c) {
    let o = ord(c)
    return o >= 48 && o <= 57
  }

  micro is_alpha(c) {
    let o = ord(c)
    return (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95
  }

  micro read_identifier(self) {
    let c = self.ch
    let s = ""
    s = s + c
    while Lexer::is_alpha(self.peek_char()) || Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro read_number(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro skip_whitespace(self) {
    # print("DEBUG: skip_whitespace entered ch=" + self.ch)
    while self.ch == " " || self.ch == "\t" || self.ch == "\n" || self.ch == "\r" {
      self.read_char()
    }
  }

  micro next_token(self) {
    print("DEBUG: next_token entered")
    loop {
      self.skip_whitespace()
      if self.ch == "#" {
        self.skip_comment()
        continue
      }
      break
    }
    
    let start_pos = self.pos
    let start_line = self.line
    let start_col = self.col
    
    print("DEBUG: calling _next_token_impl")
    let kind = self._next_token_impl()
    print("DEBUG: _next_token_impl returned")
    
    let span = new Span
    span.start = start_pos
    span.end = self.pos
    span.line = start_line
    span.col = start_col
    
    let tok = new Token
    tok.kind = kind
    tok.span = span
    return tok
  }

  micro _next_token_impl(self) {
    print("DEBUG: _next_token_impl entered")
    if self.ch == null {
        self.ch = ""
    }
    let c = self.ch
    if c == "" { return _tk("EOF") }
    
    if c == "(" {
          self.read_char()
          return _tk("LParen")
     }
     
     if c == "\"" {
            let s = self.read_string()
            return _tk1("String", s)
     } else {
       if c == "+" { self.read_char(); return _tk("Plus") }
       else {
       if c == "-" { 
            self.read_char()
            if self.ch == ">" {
                self.read_char()
                return _tk("Arrow")
            }
            return _tk("Minus") 
       } else {
       if c == "*" { self.read_char(); return _tk("Star") }
       else {
       if c == "/" { self.read_char(); return _tk("Slash") }
       else {
       if c == "(" { self.read_char(); return _tk("LParen") }
       else {
       if c == ")" { self.read_char(); return _tk("RParen") }
       else {
       if c == "{" { self.read_char(); return _tk("LBrace") }
       else {
       if c == "}" { self.read_char(); return _tk("RBrace") }
       else {
       if c == "[" { self.read_char(); return _tk("LBracket") }
       else {
       if c == "]" { self.read_char(); return _tk("RBracket") }
       else {
       if c == "=" { 
            self.read_char()
            if self.ch == "=" {
                self.read_char()
                return _tk("EqEq")
            }
            return _tk("Eq") 
       } else {
       if c == ";" { self.read_char(); return _tk("Semi") }
       else {
       if c == "," { self.read_char(); return _tk("Comma") }
       else {
       if c == ":" { self.read_char(); return _tk("Colon") }
       else {
       if c == "|" { self.read_char(); return _tk("Pipe") }
       else {
       if c == "&" { self.read_char(); return _tk("Amp") }
       else {
       if c == "?" { self.read_char(); return _tk("Question") }
       else {
       if c == "@" { self.read_char(); return _tk("At") }
       else {
       if c == "." { self.read_char(); return _tk("Dot") }
       else {
           if Lexer::is_alpha(c) {
             print("DEBUG: is_alpha matched c=" + c)
             let lit = self.read_identifier()
             print("DEBUG: read_identifier returned lit=" + lit)
              match lit {
                 case "let":
                    return _tk("KwLet")
                 case "if":
                    return _tk("KwIf")
                 case "else":
                    return _tk("KwElse")
                 case "while":
                    return _tk("KwWhile")
                 case "micro":
                    return _tk("KwMicro")
                 case "macro":
                    return _tk("KwMacro")
                 case "class":
                    return _tk("KwClass")
                 case "enum":
                    return _tk("KwEnum")
                 case "return":
                    return _tk("KwReturn")
                 case "namespace":
                    # return _tk("KwNamespace")
                    print("DEBUG: Manual TokenHelper creation for namespace")
                    let t = new TokenHelper
                    t.__variant__ = "KwNamespace"
                    return t
                 case "using":
                    return _tk("KwUsing")
                 case "imply":
                    return _tk("KwImply")
                 case "match":
                    return _tk("KwMatch")
                 case "case":
                    return _tk("KwCase")
                 case "true":
                    return _tk("KwTrue")
                 case "false":
                    return _tk("KwFalse")
                 case _:
                    let res = _tk1("Identifier", lit)
                    return res
              }
           } else {
             if Lexer::is_digit(c) {
                let num = self.read_number()
                return _tk1("Integer", num)
             } else {
                self.read_char()
                return _tk1("Identifier", c)
             }
           }
       }}}}}}}}}}}}}}}}}}}}
   }
   micro skip_comment(self) {
    while self.ch != "\n" && self.ch != "\r" && self.ch != "" {
      self.read_char()
    }
  }
  micro read_string(self) {
    self.read_char()
    let s = ""
    while self.ch != "\"" && self.ch != "" {
      s = s + self.ch
      self.read_char()
    }
    return s
  }
}
