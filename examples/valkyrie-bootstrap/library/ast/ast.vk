namespace package::ast;

class List { head, tail }

imply List {
  micro push(self, val) {
    if self.head {
      let cur = self
      while cur.tail {
        cur = cur.tail
      }
      let node = new List
      node.head = val
      cur.tail = node
    } else {
      self.head = val
    }
  }

  micro get(self, idx) {
    let cur = self
    let i = 0
    while cur {
       if i == idx { return cur.head }
        cur = cur.tail
        i = i + 1
    }
    return null
  }

  micro len(self) {
    if !self.head { return 0 }
    let n = 1
    let cur = self
    while cur.tail {
       n = n + 1
       cur = cur.tail
    }
    return n
  }

  micro set(self, idx, val) {
    let cur = self
    let i = 0
    while cur {
       if i == idx {
         cur.head = val
         return true
       }
       cur = cur.tail
       i = i + 1
    }
    return false
  }
}

enum Expr {
  Int(val, span),
  String(val, span),
  Bool(val, span),
  Variable(name, span),
  Eq(lhs, rhs, span),
  Add(lhs, rhs, span),
  Sub(lhs, rhs, span),
  Mul(lhs, rhs, span),
  Div(lhs, rhs, span),
  Call(callee, args, span),
  Field(obj, key, span),
  Index(obj, key, span)
}

enum Type {
  Name(path, span),
  Nullable(inner, span),
  Union(lhs, rhs, span),
  Intersect(lhs, rhs, span),
  Tuple(types, span),
  Apply(name, args, span),
  Function(args, ret, span),
  Unit(u, span),
  Never(u, span),
  Object(u, span),
  List(u, span)
}
enum TypeArg {
  Ty(t, span),
  Int(n, span),
  Field(name, t, span)
}

class Arg { name, type, span }
class MatchArm { pat, body, span }

enum Pattern {
  Wildcard(u, span),
  Int(val, span),
  String(val, span),
  Bool(val, span),
  Type(t, span),
  Tuple(elems, span),
  Variant(name, args, span)
}

enum Stmt {
  Let(name, type, val, span),
  Print(val, span),
  Expr(val, span),
  Block(stmts, span),
  If(cond, then_branch, else_branch, span),
  Match(scrutinee, arms, span),
  While(cond, body, span),
  Return(val, span),
  Namespace(name, span),
  Using(path, span),
  Class(name, fields, span),
  Imply(name, methods, span),
  Micro(name, args, body, span),
  Macro(name, args, body, span),
  Enum(name, variants, span),
  Decorated(decorators, stmt, span),
  Line(line)
}

class Decorator { kind, name, args, span }

