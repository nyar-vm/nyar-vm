namespace package::compiler;

using package::ast
using package::hir
using package::lir
using package::backend::wasm
using package::backend::jvm
using package::backend::clr
using package::backend::llvm
using package::backend::native

class Compiler { constants, chunks, classes, method_tables, functions, lir_functions, type_env, warnings }

imply Compiler {
  micro new() {
    let c = new Compiler
    c.constants = new List
    c.chunks = new List
    c.classes = new List
    c.method_tables = new List
    c.functions = new List
    c.lir_functions = new List
    c.type_env = new List
    c.warnings = new List
    return c
  }

  micro compile(self, program) {
    let hir = self.build_hir(program)
    self.lower_hir_to_mir(hir)
    self.finalize_inherent_impls()
    let all_chunks = self.collect_all_chunks()
    let module_bytes = self.encode_module(all_chunks)
    let out_path = "examples/valkyrie-bootstrap/target/vcc.nyarc"
    let ok = self.write_file(out_path, module_bytes)
    if ok {
      print("vcc written")
    } else {
      print("vcc write failed")
    }
    self.emit_backends()
    Compiler::print_warnings(self)
  }

  micro add_warning(self, msg) {
    self.warnings.push(msg)
  }
  micro print_warnings(self) {
    let i = 0
    let n = self.warnings.len()
    while i < n {
      print(self.warnings.get(i))
      i = i + 1
    }
  }

  micro collect_all_chunks(self) {
    let all = new List
    let main = self.build_main_chunk()
    all.push(main)
    let i = 0
    let n = self.chunks.len()
    while i < n {
      all.push(self.chunks.get(i))
      i = i + 1
    }
    return all
  }

  micro build_main_chunk(self) {
    let code = new List
    let locals = new List
    Compiler::emit_u8(code, 0xFF)
    let chunk = new List
    chunk.push(locals.len())
    chunk.push(0)
    chunk.push(32)
    chunk.push(code)
    return chunk
  }

  micro fq(ns, name) {
    if len(name) == 0 { return name }
    let i = 0
    let has_colon = false
    let n = len(name)
    while i < n {
      if eq(get(i, name), ":") {
        if i + 1 < n {
          if eq(get(i + 1, name), ":") { has_colon = true }
        }
      }
      i = i + 1
    }
    if has_colon { return name }
    if len(ns) == 0 { return name }
    return ns + "::" + name
  }

  micro build_hir(self, program) {
    let m = Module::new()
    if program.__variant__ == "Block" {
      let stmts = program._0
      let i = 0
      let n = stmts.len()
      while i < n {
        let s = stmts.get(i)
        let tag = s.__variant__
        if tag == "Namespace" {
          m.ns = s._0
        } else {
          if tag == "Using" {
            m.imports.push(s._0)
          } else {
            if tag == "Class" {
              let qn = Compiler::fq(m.ns, s._0)
              let cls = HIRClass::new(qn, s._1)
              m.class_list.push(cls)
            } else {
              if tag == "Imply" {
                let cname = Compiler::fq(m.ns, s._0)
                let ms = s._1
                let j = 0
                let k = ms.len()
                let impl_methods = new List
                while j < k {
                  let mi = ms.get(j)
                  if mi.__variant__ == "Micro" {
                    let mname = cname + "::" + mi._0
                    let f = HIRFunc::new(mname, mi._1, mi._2)
                    impl_methods.push(f)
                  }
                  j = j + 1
                }
                let x = HIRImpl::new(cname, impl_methods)
                m.impl_list.push(x)
              } else {
                if tag == "Micro" {
                  let qn = Compiler::fq(m.ns, s._0)
                  let f = HIRFunc::new(qn, s._1, s._2)
                  m.funcs.push(f)
                } else {
                  if tag == "Macro" {
                    let qn = Compiler::fq(m.ns, s._0)
                    let f = HIRMacro::new(qn, s._1, s._2)
                    m.macros.push(f)
                  } else {
                    m.init_stmts.push(s)
                  }
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
    return m
  }

  micro lower_hir_to_mir(self, m) {
    let init_code = new List
    let init_locals = new List
    Compiler::add_int(self.constants, 0)
    let i = 0
    let ni = m.init_stmts.len()
    while i < ni {
      let s = m.init_stmts.get(i)
      Compiler::compile_stmt(self.constants, init_code, init_locals, s)
      i = i + 1
    }
    Compiler::emit_u8(init_code, 0xFF)
    let main_chunk = new List
    main_chunk.push(init_locals.len())
    main_chunk.push(0)
    main_chunk.push(32)
    main_chunk.push(init_code)
    let nc = m.class_list.len()
    let j = 0
    while j < nc {
      let c = m.class_list.get(j)
      let cls = new List
      cls.push(c.name)
      cls.push(c.fields)
      self.classes.push(cls)
      j = j + 1
    }
    let ni2 = m.funcs.len()
    let k = 0
    while k < ni2 {
      let f = m.funcs.get(k)
      self.compile_micro(f.name, f.args, f.body)
      k = k + 1
    }
    let ni3 = m.macros.len()
    let l = 0
    while l < ni3 {
      let f = m.macros.get(l)
      self.compile_micro(f.name, f.args, f.body)
      l = l + 1
    }
    let nim = m.impl_list.len()
    let p = 0
    while p < nim {
      let im = m.impl_list.get(p)
      let cname = im.class_name
      let q = 0
      let nm = im.methods.len()
      while q < nm {
        let mf = im.methods.get(q)
        self.compile_micro(mf.name, mf.args, mf.body)
        q = q + 1
      }
      p = p + 1
    }
    let all_chunks = new List
    all_chunks.push(main_chunk)
    let t = 0
    let nt = self.chunks.len()
    while t < nt {
      all_chunks.push(self.chunks.get(t))
      t = t + 1
    }
    self.chunks = all_chunks.tail
    return true
  }

  micro compile_top_level(self, code, locals, stmt) {
      let tag = stmt.__variant__
      if tag == "Class" {
         self.compile_class(stmt._0, stmt._1)
      } else {
         if tag == "Imply" {
            self.compile_imply(stmt._0, stmt._1)
         } else {
            if tag == "Micro" {
               self.compile_micro(stmt._0, stmt._1, stmt._2)
            } else {
               if tag == "Namespace" || tag == "Using" {
               } else {
                  Compiler::compile_stmt(self.constants, code, locals, stmt)
               }
            }
         }
      }
  }

  micro compile_class(self, name, fields) {
     let cls = new List
     cls.push(name)
     cls.push(fields)
     self.classes.push(cls)
  }

  micro compile_imply(self, class_name, methods) {
     let i = 0
     let n = methods.len()
     while i < n {
        let m = methods.get(i)
        if m.__variant__ == "Micro" {
           let m_name = m._0
           let q_name = class_name + "::" + m_name
           self.compile_micro(q_name, m._1, m._2)
        }
        i = i + 1
     }
  }

  micro compile_micro(self, name, args, body) {
     let code = new List
     let locals = new List
     let i = 0
     let n = args.len()
     while i < n {
        let a = args.get(i)
        if a.__variant__ == "Arg" {
          locals.push(a.name)
          let ty = a.type
          if ty.__variant__ == "Name" {
            if len(ty._0) == 0 {
              let anyt = Type::Name("any", null)
              Compiler::set_type(self, a.name, anyt)
              Compiler::add_warning(self, "[any] arg " + a.name + " in " + name + " missing type")
            } else {
              Compiler::set_type(self, a.name, ty)
            }
          } else {
            Compiler::set_type(self, a.name, ty)
          }
        } else {
          locals.push(a)
        }
        i = i + 1
     }
     Compiler::compile_stmt(self.constants, code, locals, body)
     Compiler::emit_u8(code, 0x01)
     let idx = Compiler::add_int(self.constants, 0)
     Compiler::emit_u16(code, idx)
     Compiler::emit_u8(code, 0x12)
     let chunk = new List
     chunk.push(locals.len())
     chunk.push(0)
     chunk.push(32)
     chunk.push(code)
     self.chunks.push(chunk)
     let idx2 = self.chunks.len()
     let func = new List
     func.push(name)
     func.push(idx2)
     self.functions.push(func)
     let lir_func = LIRFunction::new(name, args)
     let bb = BasicBlock::new()
     Compiler::lower_stmt_to_lir(self, bb, body)
     bb.push(LIRInstr::Return(0))
     lir_func.add_block(bb)
     self.lir_functions.push(lir_func)
  }

  micro resolve_class_idx(self, name) {
     let i = 0
     let n = self.classes.len()
     while i < n {
        let c = self.classes.get(i)
        if eq(c.head, name) { return i }
        i = i + 1
     }
     return -1
  }

  micro finalize_inherent_impls(self) {
    let i = 0
    let n = self.classes.len()
    while i < n {
       let cls = self.classes.get(i)
       let c_name = cls.head
       let methods = new List
       let method_chunks = new List
       let j = 0
       let m = self.functions.len()
       while j < m {
          let f = self.functions.get(j)
          let f_name = f.head
          let prefix = c_name + "::"
          let p_len = len(prefix)
          if len(f_name) > p_len {
             let prefix_match = true
             let k = 0
             while k < p_len {
                if get(k, f_name) != get(k, prefix) { prefix_match = false }
                k = k + 1
             }
             if prefix_match {
                let m_name = ""
                let k2 = p_len
                while k2 < len(f_name) {
                   m_name = m_name + chr(ord(get(k2, f_name)))
                   k2 = k2 + 1
                }
                methods.push(m_name)
                method_chunks.push(f.tail.head)
             }
          }
          j = j + 1
       }
       if methods.len() > 0 {
          let mt = new List
          mt.push(i)
          mt.push(methods)
          mt.push(method_chunks)
          self.method_tables.push(mt)
       }
       i = i + 1
    }
  }

  micro write_file(path, bytes_str) {
    let res = eq(true, write_file(path, bytes_str))
    return res
  }

  micro resolve_local(locals, name) {
    let i = 0
    let n = locals.len()
    while i < n {
       let v = locals.get(i)
       if eq(v, name) { return i }
       i = i + 1
    }
    return -1
  }

  micro declare_local(locals, name) {
     let idx = Compiler::resolve_local(locals, name)
     if idx != -1 { return idx }
     locals.push(name)
     return locals.len() - 1
  }

  micro add_string(constants, s) {
    let i = 0
    let n = constants.len()
    while i < n {
      let cur = constants.get(i)
      let tag = cur.__variant__
      if tag == "String" {
        if eq(cur._0, s) { return i }
      }
      i = i + 1
    }
    constants.push(Expr::String(s, null))
    return i
  }

  micro add_int(constants, v) {
    let i = 0
    let n = constants.len()
    while i < n {
      let cur = constants.get(i)
      let tag = cur.__variant__
      if tag == "Int" {
        if eq(cur._0, v) { return i }
      }
      i = i + 1
    }
    constants.push(Expr::Int(v, null))
    return i
  }

  micro emit_u8(code, b) {
    code.push(b)
  }
  micro emit_u16(code, n) {
    let b0 = Compiler::mod256(n)
    let q = Compiler::div256(n)
    let b1 = Compiler::mod256(q)
    Compiler::emit_u8(code, b0)
    Compiler::emit_u8(code, b1)
  }
  micro emit_u32(code, n) {
    let b0 = Compiler::mod256(n)
    let q1 = Compiler::div256(n)
    let b1 = Compiler::mod256(q1)
    let q2 = Compiler::div256(q1)
    let b2 = Compiler::mod256(q2)
    let q3 = Compiler::div256(q2)
    let b3 = Compiler::mod256(q3)
    Compiler::emit_u8(code, b0)
    Compiler::emit_u8(code, b1)
    Compiler::emit_u8(code, b2)
    Compiler::emit_u8(code, b3)
  }
  micro emit_bytes(code, s) {
    let i = 0
    let n = len(s)
    while i < n {
      Compiler::emit_u8(code, ord(get(i, s)))
      i = i + 1
    }
  }
  micro div256(n) {
    let q = 0
    let t = n
    loop {
      if t < 256 { break }
      t = t - 256
      q = q + 1
    }
    return q
  }
  micro mod256(n) {
    let t = n
    loop {
      if t < 256 { break }
      t = t - 256
    }
    return t
  }
  micro to_string_from_bytes(code) {
    let s = ""
    let i = 0
    let n = code.len()
    while i < n {
      let v = code.get(i)
      s = s + chr(v)
      i = i + 1
    }
    return s
  }

  micro encode_u16(n) {
    let buf = new List
    Compiler::emit_u16(buf, n)
    return Compiler::to_string_from_bytes(buf)
  }
  micro encode_u32(n) {
    let buf = new List
    Compiler::emit_u32(buf, n)
    return Compiler::to_string_from_bytes(buf)
  }
  micro encode_string(s) {
    let len_s = Compiler::encode_u32(len(s))
    return len_s + s
  }

  micro encode_module(self, chunks) {
    let header = "NYAR" + chr(1) + chr(0) + chr(0) + chr(0)
    let version = Compiler::encode_u16(1)
    let flags = Compiler::encode_u32(0)
    let timestamp = Compiler::encode_u32(0) + Compiler::encode_u32(0)
    let const_count = Compiler::encode_u32(self.constants.len())
    let const_bytes = Compiler::encode_constants(self.constants)
    let eff_count = Compiler::encode_u32(0)
    let chunks_count = Compiler::encode_u32(chunks.len())
    let chunks_bytes = Compiler::encode_chunks(chunks)
    let classes_bytes = Compiler::encode_classes(self.classes)
    let traits_list = self.build_trait_list()
    let impls_list = self.build_impl_list(traits_list)
    let traits_bytes = Compiler::encode_traits(traits_list)
    let impls_bytes = Compiler::encode_impls(impls_list)
    return header + version + flags + timestamp + const_count + const_bytes + eff_count + chunks_count + chunks_bytes + classes_bytes + traits_bytes + impls_bytes
  }

  micro emit_backends(self) {
    let lir_mod = LIRModule::from_compiler(self)
    let w = new WasmBackend
    let wm = w.emit_core(lir_mod)
    self.write_file(w.output_path(), wm)
    let wc = w.emit_component(lir_mod)
    self.write_file(w.component_output_path(), wc)
    let j = new JVMBackend
    j.emit(lir_mod)
    let c = new CLRBackend
    let cb = c.emit(lir_mod)
    self.write_file(c.output_path(), cb)
    let l = new LLVMBackend
    let lb = l.emit(lir_mod)
    self.write_file(l.output_path(), lb)
    let n = new NativeBackend
    let nb = n.emit(lir_mod)
    self.write_file(n.output_path(), nb)
  }

  micro encode_chunks(chunks) {
     let s = ""
     let i = 0
     let n = chunks.len()
     while i < n {
        let chunk = chunks.get(i)
        let locals = chunk.get(0)
        let upvalues = chunk.get(1)
        let max_stack = chunk.get(2)
        let code = chunk.get(3)
        s = s + Compiler::encode_u16(locals)
        s = s + Compiler::encode_u16(upvalues)
        s = s + Compiler::encode_u16(max_stack)
        let code_str = Compiler::to_string_from_bytes(code)
        s = s + Compiler::encode_u32(len(code_str))
        s = s + code_str
        i = i + 1
     }
     return s
  }

  micro encode_classes(classes) {
     if classes.len() == 0 { return "" }
     let s = Compiler::encode_u32(classes.len())
     let i = 0
     let n = classes.len()
     while i < n {
        let cls = classes.get(i)
        let name = cls.get(0)
        let fields = cls.get(1)
        s = s + Compiler::encode_string(name)
        s = s + Compiler::encode_u16(fields.len())
        let j = 0
        let m = fields.len()
        while j < m {
           s = s + Compiler::encode_string(fields.get(j))
           j = j + 1
        }
        i = i + 1
     }
     return s
  }

  micro encode_traits(traits) {
     if traits.len() == 0 { return "" }
     let s = Compiler::encode_u32(traits.len())
     let i = 0
     let n = traits.len()
     while i < n {
        let tr = traits.get(i)
        let name = tr.get(0)
        let methods = tr.get(1)
        s = s + Compiler::encode_string(name)
        s = s + Compiler::encode_u16(methods.len())
        let j = 0
        let m = methods.len()
        while j < m {
           s = s + Compiler::encode_string(methods.get(j))
           j = j + 1
        }
        i = i + 1
     }
     return s
  }

  micro encode_impls(impls) {
     if impls.len() == 0 { return "" }
     let s = Compiler::encode_u32(impls.len())
     let i = 0
     let n = impls.len()
     while i < n {
        let imp = impls.get(i)
        let c_idx = imp.get(0)
        let t_idx = imp.get(1)
        let methods = imp.get(2)
        s = s + Compiler::encode_u16(c_idx)
        s = s + Compiler::encode_u16(t_idx)
        s = s + Compiler::encode_u16(methods.len())
        let j = 0
        let m = methods.len()
        while j < m {
           s = s + Compiler::encode_u16(methods.get(j))
           j = j + 1
        }
        i = i + 1
     }
     return s
  }

  micro build_trait_list(self) {
     let out = new List
     let i = 0
     let n = self.method_tables.len()
     while i < n {
        let mt = self.method_tables.get(i)
        let c_idx = mt.get(0)
        let methods = mt.get(1)
        let cls = self.classes.get(c_idx)
        let c_name = cls.get(0)
        let trait_name = c_name + "::__methods__"
        let t = new List
        t.push(trait_name)
        t.push(methods)
        out.push(t)
        i = i + 1
     }
     return out
  }

  micro build_impl_list(self, traits_list) {
     let out = new List
     let i = 0
     let n = self.method_tables.len()
     while i < n {
        let mt = self.method_tables.get(i)
        let c_idx = mt.get(0)
        let methods_chunks = mt.get(2)
        let trait_idx = i
        let imp = new List
        imp.push(c_idx)
        imp.push(trait_idx)
        imp.push(methods_chunks)
        out.push(imp)
        i = i + 1
     }
     return out
  }

  micro encode_constants(constants) {
    let s = ""
    let i = 0
    let n = constants.len()
    while i < n {
      let c = constants.get(i)
      let tag = c.__variant__
      if tag == "Int" {
        s = s + chr(0)
        let v = c._0
        let u = v
        if v < 0 { u = 0 }
        let b0 = Compiler::encode_u32(u)
        let b1 = Compiler::encode_u32(0)
        s = s + b0 + b1
      } else {
        if tag == "String" {
          s = s + chr(2)
          s = s + Compiler::encode_string(c._0)
        } else {
          s = s + chr(0) + Compiler::encode_u32(0) + Compiler::encode_u32(0)
        }
      }
      i = i + 1
    }
    return s
  }

  micro patch_u16(code, idx, n) {
    let b0 = Compiler::mod256(n)
    let q = Compiler::div256(n)
    let b1 = Compiler::mod256(q)
    code.set(idx, b0)
    code.set(idx + 1, b1)
  }

  micro compile_stmt(constants, code, locals, stmt) {
    let tag = stmt.__variant__
    if tag == "Block" {
      let stmts = stmt._0
      let i = 0
      let n = stmts.len()
      while i < n {
        let s = stmts.get(i)
        Compiler::compile_stmt(constants, code, locals, s)
        i = i + 1
      }
      } else {
        if tag == "Print" {
          Compiler::compile_expr(constants, code, locals, stmt._0)
          let didx = Compiler::add_string(constants, "print")
          Compiler::emit_u8(code, 0xF0)
          Compiler::emit_u16(code, didx)
          Compiler::emit_u8(code, 1)
        } else {
          if tag == "Expr" {
            Compiler::compile_expr(constants, code, locals, stmt._0)
            Compiler::emit_u8(code, 0x02)
          } else {
          if tag == "Let" {
             let name = stmt._0
             let val = stmt._2
             Compiler::compile_expr(constants, code, locals, val)
             let idx = Compiler::declare_local(locals, name)
             Compiler::emit_u8(code, 0x06)
             Compiler::emit_u8(code, idx)
          } else {
             if tag == "If" {
               let cond = stmt._0
               let then_b = stmt._1
               let else_b = stmt._2
               Compiler::compile_expr(constants, code, locals, cond)
               Compiler::emit_u8(code, 0x11)
               let jump_false_idx = code.len()
               Compiler::emit_u16(code, 0)
               Compiler::compile_stmt(constants, code, locals, then_b)
               Compiler::emit_u8(code, 0x10)
               let jump_end_idx = code.len()
               Compiler::emit_u16(code, 0)
               let else_start = code.len()
               let offset_false = else_start - jump_false_idx - 2
               Compiler::patch_u16(code, jump_false_idx, offset_false)
               Compiler::compile_stmt(constants, code, locals, else_b)
               let end = code.len()
               let offset_end = end - jump_end_idx - 2
               Compiler::patch_u16(code, jump_end_idx, offset_end)
             } else {
               if tag == "Match" {
                 # Store scrutinee in a temporary local
                 Compiler::compile_expr(constants, code, locals, stmt._0)
                 let tmp_name = "__match_tmp_" + Compiler::encode_u32(code.len()) # Unique-ish name? No, just reuse.
                 # Actually, locals are managed by list, so declaring a new local is fine.
                 let tmp_idx = Compiler::declare_local(locals, "match_scrutinee")
                 Compiler::emit_u8(code, 0x06) # StoreLocal
                 Compiler::emit_u8(code, tmp_idx)
                 
                 let arms = stmt._1
                 let j = 0
                 let m = arms.len()
                 
                 let jump_ends = new List
                 
                 while j < m {
                   let arm = arms.get(j)
                   let pat = arm.pat
                   let ptag = pat.__variant__
                   
                   let jump_next_arm = -1
                   
                   # Pattern Match Check
                   if ptag == "Wildcard" {
                      # Always matches
                   } else {
                      # Load scrutinee
                      Compiler::emit_u8(code, 0x05) # LoadLocal
                      Compiler::emit_u8(code, tmp_idx)
                      
                      if ptag == "String" {
                         let s_idx = Compiler::add_string(constants, pat._0)
                         Compiler::emit_u8(code, 0x01) # Push Const
                         Compiler::emit_u16(code, s_idx)
                         Compiler::emit_u8(code, 0xC6) # StringExt
                         Compiler::emit_u8(code, 0x10) # Eq
                      } else {
                         if ptag == "Int" {
                            let i_idx = Compiler::add_int(constants, pat._0)
                            Compiler::emit_u8(code, 0x01) # Push Const
                            Compiler::emit_u16(code, i_idx)
                            Compiler::emit_u8(code, 0xC2) # I64Ext
                            Compiler::emit_u8(code, 0x10) # Eq
                         } else {
                             # Fallback / TODO: Other patterns
                             Compiler::emit_u8(code, 0x02) # Pop scrutinee
                             Compiler::emit_u8(code, 0x01) # Push false
                             let f_idx = Compiler::add_int(constants, 0)
                             Compiler::emit_u16(code, f_idx)
                             # Or use Eq(0)
                         }
                      }
                      
                      # Jump if false to next arm
                      Compiler::emit_u8(code, 0x11) # JumpIfFalse
                      jump_next_arm = code.len()
                      Compiler::emit_u16(code, 0)
                   }
                   
                   # Arm Body
                   Compiler::compile_stmt(constants, code, locals, arm.body)
                   
                   # Jump to end (if not last arm or if wildcard?)
                   # Actually, after body, jump to end.
                   Compiler::emit_u8(code, 0x10) # Jump
                   let je = code.len()
                   Compiler::emit_u16(code, 0)
                   jump_ends.push(je)
                   
                   # Patch JumpIfFalse
                   if jump_next_arm != -1 {
                      let next_start = code.len()
                      let off = next_start - jump_next_arm - 2
                      Compiler::patch_u16(code, jump_next_arm, off)
                   }
                   
                   j = j + 1
                 }
                 
                 # Patch all jumps to end
                 let end_pos = code.len()
                 let k = 0
                 let n_ends = jump_ends.len()
                 while k < n_ends {
                    let je = jump_ends.get(k)
                    let off = end_pos - je - 2
                    Compiler::patch_u16(code, je, off)
                    k = k + 1
                 }
               }
             }
          }
        }
      }
    }
  }
  
  micro compile_expr(constants, code, locals, expr) {
    let tag = expr.__variant__
    if tag == "Int" {
      let idx = Compiler::add_int(constants, expr._0)
      Compiler::emit_u8(code, 0x01)
      Compiler::emit_u16(code, idx)
    } else {
      if tag == "String" {
        let idx = Compiler::add_string(constants, expr._0)
        Compiler::emit_u8(code, 0x01)
        Compiler::emit_u16(code, idx)
      } else {
        if tag == "Variable" {
           let name = expr._0
           let idx = Compiler::resolve_local(locals, name)
           if idx != -1 {
              Compiler::emit_u8(code, 0x05)
              Compiler::emit_u8(code, idx)
           } else {
              let idx0 = Compiler::add_int(constants, 0)
              Compiler::emit_u8(code, 0x01)
              Compiler::emit_u16(code, idx0)
           }
        } else {
            if tag == "Add" {
              Compiler::compile_expr(constants, code, locals, expr._0)
              Compiler::compile_expr(constants, code, locals, expr._1)
              Compiler::emit_u8(code, 0xC2)
              Compiler::emit_u8(code, 0x01)
            } else {
            }
        }
      }
    }
  }

  micro lower_expr_to_lir(self, block, expr) {
    let tag = expr.__variant__
    if tag == "Int" {
      block.push(LIRInstr::ConstInt(expr._0))
    } else {
      if tag == "Bool" {
        block.push(LIRInstr::ConstInt(expr._0))
      } else {
      if tag == "String" {
        block.push(LIRInstr::ConstString(expr._0))
      } else {
        if tag == "Call" {
          let callee = expr._0
          let args = expr._1
          let i0 = 0
          let n0 = args.len()
          while i0 < n0 {
            Compiler::lower_expr_to_lir(self, block, args.get(i0))
            i0 = i0 + 1
          }
          if callee.__variant__ == "Variable" {
            block.push(LIRInstr::Call(callee._0, n0))
          } else {
            block.push(LIRInstr::Call("", n0))
          }
      } else {
        if tag == "Variable" {
          block.push(LIRInstr::LoadLocal(expr._0))
        } else {
          if tag == "Add" {
            let t0 = Compiler::resolve_expr_type(self, expr._0)
            let t1 = Compiler::resolve_expr_type(self, expr._1)
            if Compiler::type_is_string(t0) && Compiler::type_is_string(t1) {
              Compiler::lower_expr_to_lir(self, block, expr._0)
              Compiler::lower_expr_to_lir(self, block, expr._1)
              block.push(LIRInstr::CallFFI("__str_concat", 2))
            } else {
              Compiler::lower_expr_to_lir(self, block, expr._0)
              Compiler::lower_expr_to_lir(self, block, expr._1)
              block.push(LIRInstr::AddI64(0))
            }
          } else {
            if tag == "Eq" {
              let t0e = Compiler::resolve_expr_type(self, expr._0)
              let t1e = Compiler::resolve_expr_type(self, expr._1)
              Compiler::lower_expr_to_lir(self, block, expr._0)
              Compiler::lower_expr_to_lir(self, block, expr._1)
              if Compiler::type_is_string(t0e) && Compiler::type_is_string(t1e) {
                block.push(LIRInstr::EqStr(0))
              } else {
                block.push(LIRInstr::EqI64(0))
              }
            } else {
            if tag == "Sub" {
              Compiler::lower_expr_to_lir(self, block, expr._0)
              Compiler::lower_expr_to_lir(self, block, expr._1)
              block.push(LIRInstr::SubI64(0))
            } else {
              if tag == "Mul" {
                Compiler::lower_expr_to_lir(self, block, expr._0)
                Compiler::lower_expr_to_lir(self, block, expr._1)
                block.push(LIRInstr::MulI64(0))
              } else {
                if tag == "Div" {
                  Compiler::lower_expr_to_lir(self, block, expr._0)
                  Compiler::lower_expr_to_lir(self, block, expr._1)
                  block.push(LIRInstr::DivI64(0))
                } else {
                }
              }
            }
            }
          }
        }
        }
      }
      }
    }
  }

  micro lower_stmt_to_lir(self, block, stmt) {
    let tag = stmt.__variant__
    if tag == "Block" {
      let stmts = stmt._0
      let i = 0
      let n = stmts.len()
      while i < n {
        let s = stmts.get(i)
        Compiler::lower_stmt_to_lir(self, block, s)
        i = i + 1
      }
    } else {
      if tag == "Print" {
        Compiler::lower_expr_to_lir(self, block, stmt._0)
        block.push(LIRInstr::CallFFI("print", 1))
        block.push(LIRInstr::Pop(0))
      } else {
        if tag == "Expr" {
          Compiler::lower_expr_to_lir(self, block, stmt._0)
          block.push(LIRInstr::Pop(0))
        } else {
          if tag == "Let" {
            let name = stmt._0
            let val = stmt._2
            let ty = stmt._1
            if ty.__variant__ == "Name" && len(ty._0) == 0 {
              let anyt2 = Type::Name("any", null)
              Compiler::set_type(self, name, anyt2)
              Compiler::add_warning(self, "[any] let " + name + " missing type")
            } else {
              Compiler::set_type(self, name, ty)
              Compiler::validate_container_on_let(self, name, ty)
            }
            Compiler::lower_expr_to_lir(self, block, val)
            block.push(LIRInstr::StoreLocal(name))
          } else {
            if tag == "Return" {
              Compiler::lower_expr_to_lir(self, block, stmt._0)
              block.push(LIRInstr::Return(0))
            } else {
              if tag == "If" {
                let ok_match = Compiler::try_lower_if_chain_as_match(self, block, stmt)
                if !ok_match {
                  let cond = stmt._0
                  let then_b = stmt._1
                  let else_b = stmt._2
                  let l_else = 1
                  let l_end = 2
                  Compiler::lower_expr_to_lir(self, block, cond)
                  block.push(LIRInstr::JumpIfFalse(l_else))
                  Compiler::lower_stmt_to_lir(self, block, then_b)
                  block.push(LIRInstr::Jump(l_end))
                  block.push(LIRInstr::Label(l_else))
                  Compiler::lower_stmt_to_lir(self, block, else_b)
                  block.push(LIRInstr::Label(l_end))
                }
              } else {
                if tag == "Match" {
                  let scrutinee = stmt._0
                  let arms = stmt._1
                  Compiler::lower_expr_to_lir(self, block, scrutinee)
                  block.push(LIRInstr::StoreLocal("match_tmp"))
                  let end_label = 9
                  let i2 = 0
                  let n2 = arms.len()
                  while i2 < n2 {
                    let arm = arms.get(i2)
                    let pat = arm.pat
                    let next_label = 10 + i2
                    let ptag = pat.__variant__
                    if ptag == "Wildcard" {
                      Compiler::lower_stmt_to_lir(self, block, arm.body)
                      block.push(LIRInstr::Jump(end_label))
                    } else {
                      if ptag == "Type" {
                        let ts = Compiler::resolve_expr_type(self, scrutinee)
                        let match_ok = Compiler::type_equals_string(ts, Compiler::type_to_string(pat._0))
                        if match_ok {
                          block.push(LIRInstr::ConstInt(1))
                        } else {
                          block.push(LIRInstr::ConstInt(0))
                        }
                      } else {
                        if ptag == "Tuple" {
                          let ts2 = Compiler::resolve_expr_type(self, scrutinee)
                          let ok2 = Compiler::type_is_tuple(ts2)
                          if ok2 {
                            block.push(LIRInstr::ConstInt(1))
                          } else {
                            block.push(LIRInstr::ConstInt(0))
                          }
                        } else {
                          block.push(LIRInstr::LoadLocal("match_tmp"))
                          if ptag == "Int" || ptag == "Bool" {
                            block.push(LIRInstr::ConstInt(pat._0))
                            block.push(LIRInstr::EqI64(0))
                          } else {
                            if ptag == "String" {
                              block.push(LIRInstr::ConstString(pat._0))
                              block.push(LIRInstr::EqStr(0))
                            } else {
                              block.push(LIRInstr::ConstInt(0))
                            }
                          }
                        }
                      }
                      block.push(LIRInstr::JumpIfFalse(next_label))
                      Compiler::lower_stmt_to_lir(self, block, arm.body)
                      block.push(LIRInstr::Jump(end_label))
                      block.push(LIRInstr::Label(next_label))
                    }
                    i2 = i2 + 1
                  }
                  block.push(LIRInstr::Label(end_label))
                } else {
                  if tag == "While" {
                    let cond = stmt._0
                    let body = stmt._1
                    let l_start = 3
                    let l_exit = 4
                    block.push(LIRInstr::Label(l_start))
                    Compiler::lower_expr_to_lir(self, block, cond)
                    block.push(LIRInstr::JumpIfFalse(l_exit))
                    Compiler::lower_stmt_to_lir(self, block, body)
                    block.push(LIRInstr::Jump(l_start))
                    block.push(LIRInstr::Label(l_exit))
                  } else {
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  micro try_lower_if_chain_as_match(self, block, stmt) {
    if stmt.__variant__ != "If" { return false }
    let scr = ""
    let arms = new List
    let default_body = null
    let cur = stmt
    loop {
      if cur.__variant__ != "If" { break }
      let cond = cur._0
      let then_b = cur._1
      let else_b = cur._2
      if cond.__variant__ != "Eq" { return false }
      let lhs = cond._0
      let rhs = cond._1
      if lhs.__variant__ != "Variable" { return false }
      if len(scr) == 0 { scr = lhs._0 }
      if !eq(scr, lhs._0) { return false }
      let pat = Pattern::Wildcard(0, null)
      if rhs.__variant__ == "Int" { pat = Pattern::Int(rhs._0, null) }
      else {
        if rhs.__variant__ == "String" { pat = Pattern::String(rhs._0, null) }
        else {
          if rhs.__variant__ == "Bool" { pat = Pattern::Bool(rhs._0, null) }
          else { return false }
        }
      }
      let arm = new MatchArm
      arm.pat = pat
      arm.body = then_b
      arm.span = null
      arms.push(arm)
      if else_b.__variant__ == "If" {
        cur = else_b
      } else {
        default_body = else_b
        break
      }
    }
    if arms.len() < 3 { return false }
    let scr_expr = Expr::Variable(scr, null)
    Compiler::lower_expr_to_lir(self, block, scr_expr)
    block.push(LIRInstr::StoreLocal("match_tmp"))
    let end_label = 19
    let i3 = 0
    let n3 = arms.len()
    while i3 < n3 {
      let arm2 = arms.get(i3)
      let next_label2 = 20 + i3
      let pt = arm2.pat.__variant__
      block.push(LIRInstr::LoadLocal("match_tmp"))
      if pt == "Int" || pt == "Bool" {
        block.push(LIRInstr::ConstInt(arm2.pat._0))
        block.push(LIRInstr::EqI64(0))
      } else {
        if pt == "String" {
          block.push(LIRInstr::ConstString(arm2.pat._0))
          block.push(LIRInstr::EqStr(0))
        } else {
          block.push(LIRInstr::ConstInt(0))
        }
      }
      block.push(LIRInstr::JumpIfFalse(next_label2))
      Compiler::lower_stmt_to_lir(self, block, arm2.body)
      block.push(LIRInstr::Jump(end_label))
      block.push(LIRInstr::Label(next_label2))
      i3 = i3 + 1
    }
    if default_body {
      Compiler::lower_stmt_to_lir(self, block, default_body)
    }
    block.push(LIRInstr::Label(end_label))
    return true
  }
  micro validate_container_on_let(self, name, ty) {
    if ty.__variant__ != "Apply" { return true }
    let cname = ty._0
    let args = ty._1
    if eq(cname, "array") {
      if args.len() < 2 { Compiler::add_warning(self, "[container] array requires elem type and length for " + name); return false }
      let a0 = args.get(0)
      let a1 = args.get(1)
      if a0.__variant__ != "Ty" { Compiler::add_warning(self, "[container] array first arg must be type for " + name); return false }
      if a1.__variant__ != "Int" { Compiler::add_warning(self, "[container] array second arg must be length int for " + name); return false }
      return true
    } else {
      if eq(cname, "vector") {
        if args.len() < 1 { Compiler::add_warning(self, "[container] vector requires elem type for " + name); return false }
        let b0 = args.get(0)
        if b0.__variant__ != "Ty" { Compiler::add_warning(self, "[container] vector first arg must be type for " + name); return false }
        return true
      } else {
        if eq(cname, "list") {
          if args.len() > 0 {
            let c0 = args.get(0)
            if c0.__variant__ != "Ty" { Compiler::add_warning(self, "[container] list arg must be type if provided for " + name); return false }
          }
          return true
        } else {
          if eq(cname, "record") {
            if args.len() == 0 { Compiler::add_warning(self, "[container] record requires fields for " + name); return false }
            let i = 0
            let n = args.len()
            while i < n {
              let f = args.get(i)
              if f.__variant__ != "Field" { Compiler::add_warning(self, "[container] record args must be Field(name:type) for " + name); return false }
              i = i + 1
            }
            return true
          } else {
            if eq(cname, "object") {
              return true
            } else {
              return true
            }
          }
        }
      }
    }
  }
  micro set_type(self, name, ty) {
    let pair = new List
    pair.push(name)
    pair.push(ty)
    self.type_env.push(pair)
  }
  micro get_type(self, name) {
    let i = 0
    let n = self.type_env.len()
    while i < n {
      let p = self.type_env.get(i)
      if eq(p.get(0), name) { return p.get(1) }
      i = i + 1
    }
    return Type::Name("", null)
  }
  micro type_to_string(t) {
    if t.__variant__ == "Name" { return t._0 }
    if t.__variant__ == "Nullable" { return Compiler::type_to_string(t._0) + "?" }
    if t.__variant__ == "Union" { return Compiler::type_to_string(t._0) + "|" + Compiler::type_to_string(t._1) }
    if t.__variant__ == "Intersect" { return Compiler::type_to_string(t._0) + "&" + Compiler::type_to_string(t._1) }
    if t.__variant__ == "Tuple" { return "tuple" }
    if t.__variant__ == "Apply" {
      let name = t._0
      let args = t._1
      let s = name + "("
      let i = 0
      let n = args.len()
      while i < n {
        let a = args.get(i)
        if a.__variant__ == "Ty" {
          s = s + Compiler::type_to_string(a._0)
        } else {
          if a.__variant__ == "Int" {
            s = s + a._0
          } else {
            if a.__variant__ == "Field" {
              s = s + a._0 + ":" + Compiler::type_to_string(a._1)
            }
          }
        }
        if i + 1 < n { s = s + "," }
        i = i + 1
      }
      s = s + ")"
      return s
    }
    return ""
  }
  micro type_is_string(t) {
    return eq(Compiler::type_to_string(t), "string")
  }
  micro type_is_tuple(t) {
    return eq(Compiler::type_to_string(t), "tuple")
  }
  micro type_equals_string(t, s) {
    return eq(Compiler::type_to_string(t), s)
  }
  micro resolve_expr_type(self, expr) {
    let tag = expr.__variant__
    if tag == "Int" { return Type::Name("i64", null) }
    if tag == "String" { return Type::Name("string", null) }
    if tag == "Bool" { return Type::Name("bool", null) }
    if tag == "Variable" {
      return Compiler::get_type(self, expr._0)
    }
    if tag == "Add" {
      let t0 = Compiler::resolve_expr_type(self, expr._0)
      let t1 = Compiler::resolve_expr_type(self, expr._1)
      if Compiler::type_is_string(t0) && Compiler::type_is_string(t1) { return Type::Name("string", null) }
      return Type::Name("i64", null)
    }
    if tag == "Sub" { return Type::Name("i64", null) }
    if tag == "Mul" { return Type::Name("i64", null) }
    if tag == "Div" { return Type::Name("i64", null) }
    return Type::Name("", null)
  }
}
