namespace package::compiler;

using package::ast

class Compiler { }

imply Compiler {
  micro compile(program) {
    let constants = new List
    let code = new List
    let const_int_zero = Compiler::add_int(constants, 0)

    Compiler::compile_stmt(constants, code, program)
    Compiler::emit_u8(code, 0xFF)

    let module_bytes = Compiler::encode_module(constants, code, 0, 0, 16)
    let out_path = "examples\\valkyrie-bootstrap\\target\\bootstrap.nyarc"
    let ok = Compiler::write_file(out_path, module_bytes)
    if ok {
      print("bootstrap written")
    } else {
      print("bootstrap write failed")
    }
  }

  micro write_file(path, bytes_str) {
    let res = eq(true, write_file(path, bytes_str))
    return res
  }

  micro add_string(constants, s) {
    let i = 0
    loop {
      let cur = get(i, constants)
      if eq(cur, null) { break }
      let tag = cur.__variant__
      if tag == "String" {
        if eq(cur._0, s) { return i }
      }
      i = i + 1
    }
    constants.push(Expr::String(s))
    return i
  }

  micro add_int(constants, v) {
    let i = 0
    loop {
      let cur = get(i, constants)
      if eq(cur, null) { break }
      let tag = cur.__variant__
      if tag == "Int" {
        if eq(cur._0, v) { return i }
      }
      i = i + 1
    }
    constants.push(Expr::Int(v))
    return i
  }

  micro emit_u8(code, b) {
    code.push(b)
  }
  micro emit_u16(code, n) {
    let b0 = Compiler::mod256(n)
    let q = Compiler::div256(n)
    let b1 = Compiler::mod256(q)
    Compiler::emit_u8(code, b0)
    Compiler::emit_u8(code, b1)
  }
  micro emit_u32(code, n) {
    let b0 = Compiler::mod256(n)
    let q1 = Compiler::div256(n)
    let b1 = Compiler::mod256(q1)
    let q2 = Compiler::div256(q1)
    let b2 = Compiler::mod256(q2)
    let q3 = Compiler::div256(q2)
    let b3 = Compiler::mod256(q3)
    Compiler::emit_u8(code, b0)
    Compiler::emit_u8(code, b1)
    Compiler::emit_u8(code, b2)
    Compiler::emit_u8(code, b3)
  }
  micro emit_bytes(code, s) {
    let i = 0
    loop {
      if i >= len(s) { break }
      Compiler::emit_u8(code, ord(get(i, s)))
      i = i + 1
    }
  }
  micro div256(n) {
    let q = 0
    let t = n
    loop {
      if t < 256 { break }
      t = t - 256
      q = q + 1
    }
    return q
  }
  micro mod256(n) {
    let t = n
    loop {
      if t < 256 { break }
      t = t - 256
    }
    return t
  }
  micro to_string_from_bytes(code) {
    let s = ""
    let i = 0
    loop {
      let v = get(i, code)
      if eq(v, null) { break }
      s = s + chr(v)
      i = i + 1
    }
    return s
  }

  micro encode_u16(n) {
    let buf = new List
    Compiler::emit_u16(buf, n)
    return Compiler::to_string_from_bytes(buf)
  }
  micro encode_u32(n) {
    let buf = new List
    Compiler::emit_u32(buf, n)
    return Compiler::to_string_from_bytes(buf)
  }
  micro encode_string(s) {
    let len_s = Compiler::encode_u32(len(s))
    return len_s + s
  }

  micro encode_module(constants, code, locals, upvalues, max_stack) {
    let header = "NYAR" + chr(1) + chr(0) + chr(0) + chr(0)
    let version = Compiler::encode_u16(1)
    let flags = Compiler::encode_u32(0)
    let timestamp = Compiler::encode_u32(0) + Compiler::encode_u32(0)
    let const_count = Compiler::encode_u32(Compiler::list_len(constants))
    let const_bytes = Compiler::encode_constants(constants)
    let eff_count = Compiler::encode_u32(0)
    let chunks_count = Compiler::encode_u32(1)
    let chunk_head = Compiler::encode_u16(locals) + Compiler::encode_u16(upvalues) + Compiler::encode_u16(max_stack)
    let code_str = Compiler::to_string_from_bytes(code)
    let code_len = Compiler::encode_u32(len(code_str))
    let classes = ""
    let traits = ""
    let impls = ""
    return header + version + flags + timestamp + const_count + const_bytes + eff_count + chunks_count + chunk_head + code_len + code_str + classes + traits + impls
  }
  micro list_len(list) {
    let i = 0
    loop {
      if eq(get(i, list), null) { break }
      i = i + 1
    }
    return i
  }
  micro encode_constants(constants) {
    let s = ""
    let i = 0
    loop {
      let c = get(i, constants)
      if eq(c, null) { break }
      let tag = c.__variant__
      if tag == "Int" {
        s = s + chr(0)
        let v = c._0
        let u = v
        if v < 0 { u = 0 }
        let b0 = Compiler::encode_u32(u)
        let b1 = Compiler::encode_u32(0)
        s = s + b0 + b1
      } else {
        if tag == "String" {
          s = s + chr(2)
          s = s + Compiler::encode_string(c._0)
        } else {
          s = s + chr(0) + Compiler::encode_u32(0) + Compiler::encode_u32(0)
        }
      }
      i = i + 1
    }
    return s
  }

  micro compile_stmt(constants, code, stmt) {
    let tag = stmt.__variant__
    if tag == "Block" {
      let i = 0
      loop {
        let s = get(i, stmt._0)
        if eq(s, null) { break }
        Compiler::compile_stmt(constants, code, s)
        i = i + 1
      }
    } else {
      if tag == "Print" {
        Compiler::compile_expr(constants, code, stmt._0)
        let didx = Compiler::add_string(constants, "print")
        Compiler::emit_u8(code, 0xF0)
        Compiler::emit_u16(code, didx)
        Compiler::emit_u8(code, 1)
        Compiler::emit_u8(code, 0x02)
      } else {
        if tag == "Expr" {
          Compiler::compile_expr(constants, code, stmt._0)
          Compiler::emit_u8(code, 0x02)
        } else {
          if tag == "Let" {
            Compiler::compile_expr(constants, code, stmt._1)
            Compiler::emit_u8(code, 0x02)
          } else {
          }
        }
      }
    }
  }
  micro compile_expr(constants, code, expr) {
    let tag = expr.__variant__
    if tag == "Int" {
      let idx = Compiler::add_int(constants, expr._0)
      Compiler::emit_u8(code, 0x01)
      Compiler::emit_u16(code, idx)
    } else {
      if tag == "String" {
        let idx = Compiler::add_string(constants, expr._0)
        Compiler::emit_u8(code, 0x01)
        Compiler::emit_u16(code, idx)
      } else {
        if tag == "Add" {
          Compiler::compile_expr(constants, code, expr._0)
          Compiler::compile_expr(constants, code, expr._1)
          Compiler::emit_u8(code, 0xC2)
          Compiler::emit_u8(code, 0x01)
        } else {
          if tag == "Sub" {
            Compiler::compile_expr(constants, code, expr._0)
            Compiler::compile_expr(constants, code, expr._1)
            Compiler::emit_u8(code, 0xC2)
            Compiler::emit_u8(code, 0x02)
          } else {
            if tag == "Mul" {
              Compiler::compile_expr(constants, code, expr._0)
              Compiler::compile_expr(constants, code, expr._1)
              Compiler::emit_u8(code, 0xC2)
              Compiler::emit_u8(code, 0x03)
            } else {
              if tag == "Div" {
                Compiler::compile_expr(constants, code, expr._0)
                Compiler::compile_expr(constants, code, expr._1)
                Compiler::emit_u8(code, 0xC2)
                Compiler::emit_u8(code, 0x04)
              } else {
                let idx = Compiler::add_int(constants, 0)
                Compiler::emit_u8(code, 0x01)
                Compiler::emit_u16(code, idx)
              }
            }
          }
        }
      }
    }
  }
}
