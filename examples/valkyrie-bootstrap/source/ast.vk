namespace package::ast;

class List { head, tail }

imply List {
  micro push(self, val) {
    if self.head {
      let cur = self
      while cur.tail {
        cur = cur.tail
      }
      let node = new List
      node.head = val
      cur.tail = node
    } else {
      self.head = val
    }
  }
}

enum Expr {
  Int(val),
  String(val),
  Bool(val),
  Variable(name),
  Add(lhs, rhs),
  Sub(lhs, rhs),
  Mul(lhs, rhs),
  Div(lhs, rhs),
  Call(callee, args),
}

enum Stmt {
  Let(name, val),
  Print(val),
  Expr(val),
  Block(stmts),
  If(cond, then_branch, else_branch),
  While(cond, body),
  Return(val)
}
