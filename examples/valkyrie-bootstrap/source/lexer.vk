namespace package::lexer;

enum Token {
  EOF(u),
  Identifier(x),
  String(x),
  Integer(x),
  Plus(u),
  Minus(u),
  Star(u),
  Slash(u),
  LParen(u),
  RParen(u),
  LBrace(u),
  RBrace(u),
  Eq(u),
  Semi(u),
  KwLet(u),
  KwPrint(u),
  KwIf(u),
  KwElse(u),
  KwWhile(u),
  KwMicro(u),
  KwClass(u),
  KwEnum(u),
  KwReturn(u)
}

class Lexer { input, pos, len, ch }

imply Lexer {
  micro new(input) {
    let l = new Lexer
    l.input = input
    l.pos = 0
    l.len = len(input)
    l.ch = "\0"
    l.read_char()
    return l
  }
  micro read_char(self) {
      if self.pos >= self.len {
        self.ch = "\0"
      } else {
        self.ch = get(self.pos, self.input)
      }
      self.pos = self.pos + 1
    }

  micro peek_char(self) {
    if self.pos >= self.len {
      return "\0"
    } else {
      return get(self.pos, self.input)
    }
  }

  micro is_eof(self) {
    return self.ch == "\0"
  }

  micro is_digit(c) {
    let o = ord(c)
    # print("DEBUG: is_digit char: '" + c + "' ord: " + o)
    return o >= 48 && o <= 57
  }

  micro is_alpha(c) {
    let o = ord(c)
    return (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95
  }


  micro read_identifier(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_alpha(self.peek_char()) || Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro read_number(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    self.read_char()
    return s
  }

  micro skip_whitespace(self) {
    while self.ch == " " || self.ch == "\t" || self.ch == "\n" || self.ch == "\r" {
      self.read_char()
    }
  }

  micro next_token(self) {
    loop {
      self.skip_whitespace()
      if self.ch == "#" {
        self.skip_comment()
        continue
      }
      break
    }
    let token = self._next_token_impl()
    # print("DEBUG: Lexer token: " + token.__variant__)
    return token
  }

  micro _next_token_impl(self) {
    let c = self.ch
    # print("DEBUG: next_token char: '" + c + "' ord: " + ord(c))
    if c == "\0" {
      return Token::EOF(0)
    } else if c == "+" {
      self.read_char()
      return Token::Plus(0)
    } else if c == "-" {
      self.read_char()
      return Token::Minus(0)
    } else if c == "*" {
      self.read_char()
      return Token::Star(0)
    } else if c == "/" {
      self.read_char()
      return Token::Slash(0)
    } else if c == "(" {
      self.read_char()
      return Token::LParen(0)
    } else if c == ")" {
      self.read_char()
      return Token::RParen(0)
    } else if c == "{" {
      self.read_char()
      return Token::LBrace(0)
    } else if c == "}" {
      self.read_char()
      return Token::RBrace(0)
    } else if c == "=" {
      self.read_char()
      return Token::Eq(0)
    } else if c == ";" {
      self.read_char()
      return Token::Semi(0)
    } else if c == "\"" {
      let s = self.read_string()
      self.read_char()
      return Token::String(s)
    } else if Lexer::is_alpha(c) {
      let lit = self.read_identifier()
      # print("DEBUG: read_identifier result='" + lit + "' len=" + len(lit))
      if lit == "let" {
        # print("DEBUG: matched let")
        return Token::KwLet(0)
      } else if lit == "print" {
        return Token::KwPrint(0)
      } else if lit == "if" {
        return Token::KwIf(0)
      } else if lit == "else" {
        return Token::KwElse(0)
      } else if lit == "while" {
        return Token::KwWhile(0)
      } else if lit == "micro" {
        return Token::KwMicro(0)
      } else if lit == "class" {
        return Token::KwClass(0)
      } else if lit == "enum" {
        return Token::KwEnum(0)
      } else if lit == "return" {
        return Token::KwReturn(0)
      } else {
        return Token::Identifier(lit)
      }
    } else if Lexer::is_digit(c) {
      let num = self.read_number()
      return Token::Integer(num)
    } else {
      self.read_char()
      return Token::Identifier(c)
    }
  }
  micro skip_comment(self) {
    while self.ch != "\n" && self.ch != "\r" && self.ch != "\0" {
      self.read_char()
    }
  }
  micro read_string(self) {
    self.read_char()
    let s = ""
    while self.ch != "\"" && self.ch != "\0" {
      s = s + self.ch
      self.read_char()
    }
    return s
  }
}
