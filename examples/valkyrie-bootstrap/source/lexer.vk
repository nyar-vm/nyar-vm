namespace package::lexer;

enum Token {
  EOF,
  Identifier(x),
  String(x),
  Integer(x),
  Plus,
  Minus,
  Star,
  Slash,
  LParen,
  RParen,
  LBrace,
  RBrace,
  Eq,
  Semi,
  KwLet,
  KwPrint,
  KwIf,
  KwElse,
  KwWhile,
  KwMicro,
  KwClass,
  KwEnum,
  KwReturn
}

class Lexer { input, pos, len, ch }

imply Lexer {
  micro new(input) {
    let l = new Lexer
    l.input = input
    l.pos = 0
    l.len = len(input)
    l.ch = "\0"
    l.read_char()
    return l
  }
  micro read_char(self) {
      if self.pos >= self.len {
        self.ch = "\0"
      } else {
        self.ch = get(self.pos, self.input)
      }
      self.pos = self.pos + 1
    }

  micro peek_char(self) {
    if self.pos >= self.len {
      return "\0"
    } else {
      return get(self.pos, self.input)
    }
  }

  micro is_eof(self) {
    return ord(self.ch) == 0
  }

  micro is_digit(c) {
    let o = ord(c)
    return o >= 48 && o <= 57
  }

  micro is_alpha(c) {
    let o = ord(c)
    return (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95
  }


  micro read_identifier(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_alpha(self.peek_char()) || Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    return s
  }

  micro read_number(self) {
    let s = ""
    s = s + self.ch
    while Lexer::is_digit(self.peek_char()) {
      self.read_char()
      s = s + self.ch
    }
    return s
  }

  micro skip_whitespace(self) {
    while self.ch == " " || self.ch == "\t" || self.ch == "\n" || self.ch == "\r" {
      self.read_char()
    }
  }

  micro next_token(self) {
    loop {
      self.skip_whitespace()
      if self.ch == "#" {
        self.skip_comment()
        continue
      }
      break
    }
    let c = self.ch
    if c == "\0" {
      return Token::EOF
    } else if c == "+" {
      let t = Token::Plus
      self.read_char()
      return t
    } else if c == "-" {
      let t = Token::Minus
      self.read_char()
      return t
    } else if c == "*" {
      let t = Token::Star
      self.read_char()
      return t
    } else if c == "/" {
      let t = Token::Slash
      self.read_char()
      return t
    } else if c == "(" {
      let t = Token::LParen
      self.read_char()
      return t
    } else if c == ")" {
      let t = Token::RParen
      self.read_char()
      return t
    } else if c == "{" {
      let t = Token::LBrace
      self.read_char()
      return t
    } else if c == "}" {
      let t = Token::RBrace
      self.read_char()
      return t
    } else if c == "=" {
      let t = Token::Eq
      self.read_char()
      return t
    } else if c == ";" {
      let t = Token::Semi
      self.read_char()
      return t
    } else if c == "\"" {
      let s = self.read_string()
      self.read_char()
      return Token::String(s)
    } else if Lexer::is_alpha(c) {
      let lit = self.read_identifier()
      if lit == "let" {
        let t = Token::KwLet
        self.read_char()
        return t
      } else if lit == "print" {
        let t = Token::KwPrint
        self.read_char()
        return t
      } else if lit == "if" {
        let t = Token::KwIf
        self.read_char()
        return t
      } else if lit == "else" {
        let t = Token::KwElse
        self.read_char()
        return t
      } else if lit == "while" {
        let t = Token::KwWhile
        self.read_char()
        return t
      } else if lit == "micro" {
        let t = Token::KwMicro
        self.read_char()
        return t
      } else if lit == "class" {
        let t = Token::KwClass
        self.read_char()
        return t
      } else if lit == "enum" {
        let t = Token::KwEnum
        self.read_char()
        return t
      } else if lit == "return" {
        let t = Token::KwReturn
        self.read_char()
        return t
      } else {
        let t = Token::Identifier(lit)
        self.read_char()
        return t
      }
    } else if Lexer::is_digit(c) {
      let num = self.read_number()
      let t = Token::Integer(num)
      self.read_char()
      return t
    } else {
      let t = Token::Identifier(c)
      self.read_char()
      return t
    }
  }
  micro skip_comment(self) {
    while self.ch != "\n" && self.ch != "\r" && self.ch != "\0" {
      self.read_char()
    }
  }
  micro read_string(self) {
    self.read_char()
    let s = ""
    while self.ch != "\"" && self.ch != "\0" {
      s = s + self.ch
      self.read_char()
    }
    return s
  }
}
