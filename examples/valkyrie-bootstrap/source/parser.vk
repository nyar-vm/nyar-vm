namespace package::parser;

using package::lexer
using package::ast

class Parser { lex, cur }

imply Parser {
  micro new(lex) {
    let p = new Parser
    p.lex = lex
    p.cur = p.lex.next_token()
    return p
  }
  micro advance(self) {
    self.cur = self.lex.next_token()
  }
  micro expect_semi(self) {
    match self.cur {
      Token::Semi => self.advance(),
      _ => {}
    }
  }
  micro expect_rparen(self) {
    match self.cur {
      Token::RParen => self.advance(),
      _ => {}
    }
  }
  micro parse_primary(self) {
    match self.cur {
      Token::Integer(v) => {
        self.advance()
        return Expr::Int(v)
      },
      Token::Identifier(name) => {
        self.advance()
        return Expr::Variable(name)
      },
      Token::LParen => {
        self.advance()
        let e = self.parse_expr()
        self.expect_rparen()
        return e
      },
      _ => {
        return Expr::Int("0")
      }
    }
  }
  micro parse_expr(self) {
    let left = self.parse_primary()
    loop {
      match self.cur {
        Token::Plus => {
          self.advance()
          let right = self.parse_primary()
          left = Expr::Add(left, right)
        },
        _ => break
      }
    }
    return left
  }
  micro parse_stmt(self) {
    match self.cur {
      Token::KwLet => {
        self.advance()
        match self.cur {
          Token::Identifier(name) => {
            self.advance()
            match self.cur {
              Token::Eq => self.advance(),
              _ => {}
            }
            let val = self.parse_expr()
            self.expect_semi()
            return Stmt::Let(name, val)
          },
          _ => {
            let v = self.parse_expr()
            self.expect_semi()
            return Stmt::Expr(v)
          }
        }
      },
      Token::KwPrint => {
        self.advance()
        match self.cur {
          Token::LParen => {
            self.advance()
            let e = self.parse_expr()
            self.expect_rparen()
            self.expect_semi()
            return Stmt::Print(e)
          },
          _ => {
            let e = self.parse_expr()
            self.expect_semi()
            return Stmt::Print(e)
          }
        }
      },
      _ => {
        let e = self.parse_expr()
        self.expect_semi()
        return Stmt::Expr(e)
      }
    }
  }
  micro parse_all(self) {
    let acc = new List
    loop {
      match self.cur {
        Token::EOF => break,
        _ => {
          let s = self.parse_stmt()
          print(s)
        }
      }
    }
    return Stmt::Block(acc)
  }
}
