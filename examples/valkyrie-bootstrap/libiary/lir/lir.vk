namespace package::lir;

using package::ast
using package::compiler

enum LIRInstr {
  ConstInt(val),
  ConstString(val),
  LoadLocal(name),
  StoreLocal(name),
  AddI64(u),
  SubI64(u),
  MulI64(u),
  DivI64(u),
  CallFFI(name, argc),
  Return(u),
  Pop(u),
  Label(id),
  Jump(id),
  JumpIfFalse(id)
}

class BasicBlock { instrs }

class LIRFunction { name, args, blocks }

class LIRModule { constants, chunks, classes, method_tables, functions }

imply LIRModule {
  micro new() {
    let m = new LIRModule
    m.constants = new List
    m.chunks = new List
    m.classes = new List
    m.method_tables = new List
    m.functions = new List
    return m
  }
  micro from_compiler(comp) {
    let m = LIRModule::new()
    m.constants = comp.constants
    m.chunks = comp.chunks
    m.classes = comp.classes
    m.method_tables = comp.method_tables
    m.functions = comp.lir_functions
    return m
  }
}

imply BasicBlock {
  micro new() {
    let b = new BasicBlock
    b.instrs = new List
    return b
  }
  micro push(self, instr) {
    self.instrs.push(instr)
  }
}

imply LIRFunction {
  micro new(name, args) {
    let f = new LIRFunction
    f.name = name
    f.args = args
    f.blocks = new List
    return f
  }
  micro add_block(self, block) {
    self.blocks.push(block)
  }
}
