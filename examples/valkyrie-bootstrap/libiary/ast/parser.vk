namespace package::parser;

using package::lexer
using package::ast

class Parser { lex, cur }

imply Parser {
  micro new(lex) {
    let p = new Parser
    p.lex = lex
    p.cur = p.lex.next_token()
    return p
  }
  micro advance(self) {
    self.cur = self.lex.next_token()
  }
  micro expect_semi(self) {
    let tag = self.cur.__variant__
    if tag == "Semi" {
        self.advance()
    } else {
    }
  }
  micro expect_rparen(self) {
    let tag = self.cur.__variant__
    if tag == "RParen" {
        self.advance()
    } else {
    }
  }
  micro parse_path(self) {
    let path = ""
    if self.cur.__variant__ == "Identifier" {
       path = self.cur._0
       self.advance()
       while self.cur.__variant__ == "Colon" {
          self.advance()
          if self.cur.__variant__ == "Colon" {
             self.advance()
             path = path + "::"
             if self.cur.__variant__ == "Identifier" {
                path = path + self.cur._0
                self.advance()
             }
          }
       }
    }
    return path
  }

  micro parse_fields(self) {
     let fields = new List
     if self.cur.__variant__ == "LBrace" {
        self.advance()
        while self.cur.__variant__ != "RBrace" && self.cur.__variant__ != "EOF" {
           if self.cur.__variant__ == "Identifier" {
              fields.push(self.cur._0)
              self.advance()
           }
           if self.cur.__variant__ == "Comma" {
              self.advance()
           }
        }
        if self.cur.__variant__ == "RBrace" { self.advance() }
     }
     return fields
  }

  micro parse_args(self) {
     let args = new List
     if self.cur.__variant__ == "LParen" {
        self.advance()
        while self.cur.__variant__ != "RParen" && self.cur.__variant__ != "EOF" {
           if self.cur.__variant__ == "Identifier" {
              args.push(self.cur._0)
              self.advance()
           }
           if self.cur.__variant__ == "Comma" {
              self.advance()
           }
        }
        if self.cur.__variant__ == "RParen" { self.advance() }
     }
     return args
  }

  micro parse_impl_body(self) {
     let methods = new List
     if self.cur.__variant__ == "LBrace" {
        self.advance()
        while self.cur.__variant__ != "RBrace" && self.cur.__variant__ != "EOF" {
           if self.cur.__variant__ == "KwMicro" {
              let m = self.parse_stmt()
              methods.push(m)
           } else {
              self.advance()
           }
        }
        if self.cur.__variant__ == "RBrace" { self.advance() }
     }
     return methods
  }

  micro parse_primary(self) {
    let tag = self.cur.__variant__
    if tag == "Integer" {
        let v = self.cur._0
        self.advance()
        return Expr::Int(v)
    } else {
        if tag == "String" {
            let v = self.cur._0
            self.advance()
            return Expr::String(v)
        } else {
            if tag == "Identifier" {
                let name = self.cur._0
                self.advance()
                return Expr::Variable(name)
            } else {
                if tag == "LParen" {
                    self.advance()
                    let e = self.parse_expr()
                    self.expect_rparen()
                    return e
                } else {
                    self.advance()
                    return Expr::Int(0)
                }
            }
        }
    }
  }
  micro parse_term(self) {
    let left = self.parse_primary()
    loop {
      let tag = self.cur.__variant__
      if tag == "Star" {
          self.advance()
          let right = self.parse_primary()
          left = Expr::Mul(left, right)
      } else {
         if tag == "Slash" {
            self.advance()
            let right = self.parse_primary()
            left = Expr::Div(left, right)
         } else {
            break
         }
      }
    }
    return left
  }
  micro parse_expr(self) {
    let left = self.parse_term()
    loop {
      let tag = self.cur.__variant__
      if tag == "Plus" {
          self.advance()
          let right = self.parse_term()
          left = Expr::Add(left, right)
      } else {
          if tag == "Minus" {
              self.advance()
              let right = self.parse_term()
              left = Expr::Sub(left, right)
          } else {
              break
          }
      }
    }
    return left
  }
  micro parse_stmt(self) {
    let tag = self.cur.__variant__
    
    if tag == "KwNamespace" {
        self.advance()
        let name = self.parse_path()
        self.expect_semi()
        return Stmt::Namespace(name)
    } else if tag == "KwUsing" {
        self.advance()
        let path = self.parse_path()
        self.expect_semi()
        return Stmt::Using(path)
    } else if tag == "KwClass" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let fields = self.parse_fields()
        return Stmt::Class(name, fields)
    } else if tag == "KwImply" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let methods = self.parse_impl_body()
        return Stmt::Imply(name, methods)
    } else if tag == "KwMicro" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let args = self.parse_args()
        let body = self.parse_block()
        return Stmt::Micro(name, args, body)
    } else if tag == "KwEnum" {
        self.advance()
        let name = ""
        if self.cur.__variant__ == "Identifier" {
            name = self.cur._0
            self.advance()
        }
        let variants = self.parse_fields()
        return Stmt::Enum(name, variants)
    } else if tag == "KwLet" {
        self.advance()
        let t = self.cur.__variant__
        if t == "Identifier" {
            let name = self.cur._0
            self.advance()
            let t2 = self.cur.__variant__
            if t2 == "Eq" { self.advance() }
            let val = self.parse_expr()
            self.expect_semi()
            return Stmt::Let(name, val)
        } else {
            let v = self.parse_expr()
            self.expect_semi()
            return Stmt::Expr(v)
        }
    } else {
        if tag == "KwPrint" {
            self.advance()
            let t = self.cur.__variant__
            if t == "LParen" {
                self.advance()
                let e = self.parse_expr()
                self.expect_rparen()
                self.expect_semi()
                return Stmt::Print(e)
            } else {
                let e = self.parse_expr()
                self.expect_semi()
                return Stmt::Print(e)
            }
        } else {
            if tag == "KwIf" {
                self.advance()
                let cond = self.parse_expr()
                let then_branch = self.parse_stmt()
                let else_branch = Stmt::Block(new List)
                let tag2 = self.cur.__variant__
                if tag2 == "KwElse" {
                    self.advance()
                    else_branch = self.parse_stmt()
                }
                return Stmt::If(cond, then_branch, else_branch)
            } else {
                if tag == "KwWhile" {
                    self.advance()
                    let cond = self.parse_expr()
                    let body = self.parse_stmt()
                    return Stmt::While(cond, body)
                } else {
                    if tag == "KwReturn" {
                         self.advance()
                         let val = self.parse_expr()
                         self.expect_semi()
                         return Stmt::Return(val)
                    } else {
                        if tag == "LBrace" {
                            return self.parse_block()
                        } else {
                            let e = self.parse_expr()
                            self.expect_semi()
                            return Stmt::Expr(e)
                        }
                    }
                }
            }
        }
    }
  }
  micro parse_block(self) {
    self.advance()
    let acc = new List
    loop {
       let tag = self.cur.__variant__
       if tag == "RBrace" {
           self.advance()
           break
       } else {
           if tag == "EOF" {
               break
           } else {
               let s = self.parse_stmt()
               acc.push(s)
           }
       }
    }
    return Stmt::Block(acc)
  }
  micro parse_all(self) {
    let acc = new List
    loop {
      let tag = self.cur.__variant__
      if tag == "EOF" {
        break
      }
      let s = self.parse_stmt()
      acc.push(s)
    }
    return Stmt::Block(acc)
  }
}
