/// PE header structures interface
/// Defines all header components that make up a PE file header
interface headers {
    /// Complete PE file header structure
    /// Contains all the header components that make up a PE file header
    record pe-header {
        /// DOS header (MZ header) - legacy DOS compatibility header
        dos: dos-header,
        /// NT header - contains signature and file header
        nt: nt-header,
        /// COFF header - Common Object File Format header
        coff: coff-header,
        /// Optional header - contains Windows-specific data
        optional: optional-header,
    }
    
    /// DOS header structure (MZ header)
    /// Legacy header for DOS compatibility, contains the "MZ" signature
    record dos-header {
        /// DOS signature, should be 0x5A4D ("MZ")
        e-magic: u16,
        /// Bytes on last page of file
        e-cblp: u16,
        /// Pages in file
        e-cp: u16,
        /// Relocations
        e-crlc: u16,
        /// Size of header in paragraphs
        e-cparhdr: u16,
        /// Minimum extra paragraphs needed
        e-minalloc: u16,
        /// Maximum extra paragraphs needed
        e-maxalloc: u16,
        /// Initial relative SS value
        e-ss: u16,
        /// Initial SP value
        e-sp: u16,
        /// Checksum
        e-csum: u16,
        /// Initial IP value
        e-ip: u16,
        /// Initial relative CS value
        e-cs: u16,
        /// File address of relocation table
        e-lfarlc: u16,
        /// Overlay number
        e-ovno: u16,
        /// Reserved words
        e-res: list<u16>,
        /// OEM identifier
        e-oemid: u16,
        /// OEM information
        e-oeminfo: u16,
        /// Reserved words
        e-res2: list<u16>,
        /// File address of new exe header
        e-lfanew: u32,
    }
    
    /// NT header structure
    /// Contains PE signature and file header information
    record nt-header {
        /// PE signature, should be 0x00004550 ("PE\0\0")
        signature: u32,
    }
    
    /// NT headers structure (complete)
    /// Contains PE signature, file header, and optional header
    record nt-headers {
        /// PE signature, should be 0x00004550 ("PE\0\0")
        signature: u32,
        /// COFF file header
        file-header: coff-header,
        /// Optional header (if present)
        optional-header: option<optional-header>,
    }
    
    /// COFF header structure
    /// Common Object File Format header containing machine type and section info
    record coff-header {
        /// Target machine type (e.g., 0x8664 for AMD64)
        machine: u16,
        /// Number of sections in the file
        number-of-sections: u16,
        /// Time and date stamp
        time-date-stamp: u32,
        /// File pointer to symbol table
        pointer-to-symbol-table: u32,
        /// Number of symbols in symbol table
        number-of-symbols: u32,
        /// Size of optional header
        size-of-optional-header: u16,
        /// File characteristics flags
        characteristics: u16,
    }
    
    /// Optional header structure
    /// Windows-specific header containing loader and runtime information
    record optional-header {
        /// Magic number (0x010b for PE32, 0x020b for PE32+)
        magic: u16,
        /// Major linker version
        major-linker-version: u8,
        /// Minor linker version
        minor-linker-version: u8,
        /// Size of code sections
        size-of-code: u32,
        /// Size of initialized data sections
        size-of-initialized-data: u32,
        /// Size of uninitialized data sections
        size-of-uninitialized-data: u32,
        /// Address of entry point
        address-of-entry-point: u32,
        /// Base address of code sections
        base-of-code: u32,
        /// Preferred base address of image
        image-base: u64,
        /// Section alignment in memory
        section-alignment: u32,
        /// File alignment on disk
        file-alignment: u32,
        /// Major operating system version
        major-operating-system-version: u16,
        /// Minor operating system version
        minor-operating-system-version: u16,
        /// Major image version
        major-image-version: u16,
        /// Minor image version
        minor-image-version: u16,
        /// Major subsystem version
        major-subsystem-version: u16,
        /// Minor subsystem version
        minor-subsystem-version: u16,
        /// Win32 version value
        win32-version-value: u32,
        /// Size of image in memory
        size-of-image: u32,
        /// Size of headers
        size-of-headers: u32,
        /// Checksum
        checksum: u32,
        /// Subsystem type
        subsystem: u16,
        /// DLL characteristics
        dll-characteristics: u16,
        /// Size of stack reserve
        size-of-stack-reserve: u64,
        /// Size of stack commit
        size-of-stack-commit: u64,
        /// Size of heap reserve
        size-of-heap-reserve: u64,
        /// Size of heap commit
        size-of-heap-commit: u64,
        /// Loader flags
        loader-flags: u32,
        /// Number of data directories
        number-of-rva-and-sizes: u32,
    }
}