/// PE section structures interface
/// Defines structures for PE file sections
interface sections {
    /// PE section header structure (from COFF header)
    /// Represents the header information for a section in the PE file
    record section-header {
        /// Section name (up to 8 characters)
        name: string,
        /// Virtual size of the section in memory
        virtual-size: u32,
        /// Virtual address where section is loaded in memory
        virtual-address: u32,
        /// Size of raw data on disk
        size-of-raw-data: u32,
        /// File pointer to raw data
        pointer-to-raw-data: u32,
        /// File pointer to relocations
        pointer-to-relocations: u32,
        /// File pointer to line numbers
        pointer-to-line-numbers: u32,
        /// Number of relocations
        number-of-relocations: u16,
        /// Number of line numbers
        number-of-line-numbers: u16,
        /// Section characteristics flags
        characteristics: u32,
    }
    
    /// PE section structure (header + data)
    /// Represents a complete section in the PE file with its properties and data
    record pe-section {
        /// Section name (up to 8 characters)
        name: string,
        /// Virtual size of the section in memory
        virtual-size: u32,
        /// Virtual address where section is loaded in memory
        virtual-address: u32,
        /// Size of raw data on disk
        size-of-raw-data: u32,
        /// File pointer to raw data
        pointer-to-raw-data: u32,
        /// File pointer to relocations
        pointer-to-relocations: u32,
        /// File pointer to line numbers
        pointer-to-line-numbers: u32,
        /// Number of relocations
        number-of-relocations: u16,
        /// Number of line numbers
        number-of-line-numbers: u16,
        /// Section characteristics flags
        characteristics: u32,
        /// Raw section data
        data: list<u8>,
    }
    
    /// Section characteristics flags
    /// Defines the properties and behavior of a section
    enum section-characteristics {
        /// Section contains executable code
        code,
        /// Section contains initialized data
        initialized-data,
        /// Section contains uninitialized data
        uninitialized-data,
        /// Section can be discarded
        discardable,
        /// Section cannot be cached
        not-cached,
        /// Section cannot be paged
        not-paged,
        /// Section can be shared in memory
        shareable,
        /// Section is executable
        executable,
        /// Section is readable
        readable,
        /// Section is writable
        writable,
    }
}