/// x86 instruction set interface
/// Defines x86 architecture instructions and operands
interface x86-instructions {
    use types.{pe-error, encoded-instruction};
    
    /// x86 instruction operands
    /// Represents different types of operands for x86 instructions
    variant x86-operand {
        /// 8-bit register operand
        reg8(u8),
        /// 16-bit register operand
        reg16(u16),
        /// 32-bit register operand
        reg32(u32),
        /// 8-bit immediate value
        imm8(u8),
        /// 16-bit immediate value
        imm16(u16),
        /// 32-bit immediate value
        imm32(u32),
        /// Memory reference with displacement
        mem-disp(u32),
        /// Memory reference with base register and displacement
        mem-base-disp(tuple<u8, u32>),
        /// Memory reference with base, index registers and displacement
        mem-base-index-disp(tuple<u8, u8, u8, u32>),
        /// Relative offset for jump instructions
        rel-offset(u32),
    }
    
    /// x86 instruction opcodes
    /// Enumeration of common x86 instruction opcodes
    enum x86-opcode {
        // Data movement instructions
        mov,
        push,
        pop,
        lea,
        
        // Arithmetic instructions
        add,
        sub,
        mul,
        div,
        inc,
        dec,
        neg,
        
        // Logic instructions
        and,
        or,
        xor,
        not,
        
        // Shift/rotate instructions
        shl,
        shr,
        sar,
        rol,
        ror,
        
        // Control flow instructions
        jmp,
        je,
        jne,
        jg,
        jge,
        jl,
        jle,
        ja,
        jb,
        call,
        ret,
        
        // Stack instructions
        pushad,
        popad,
        pushfd,
        popfd,
        
        // String instructions
        movs,
        cmps,
        scas,
        lods,
        stos,
        
        // I/O instructions
        in,
        out,
        
        // Flag control
        stc,
        clc,
        std,
        cld,
        
        // Other
        nop,
        int,
        hlt,
    }
    
    /// x86 instruction structure
    /// Represents a complete x86 instruction with opcode and operands
    record x86-instruction {
        /// Instruction opcode
        opcode: x86-opcode,
        /// Instruction operands (0-3 operands)
        operands: list<x86-operand>,
        /// Instruction prefix bytes
        prefixes: list<u8>,
        /// Instruction size in bytes
        size: u8,
    }
    
    /// Encodes an x86 instruction into binary form
    /// Takes an x86 instruction and returns its encoded form or error
    encode: func(instruction: x86-instruction) -> result<encoded-instruction, pe-error>;
    
    /// Decodes binary data into an x86 instruction
    /// Takes binary data and returns the decoded instruction or error
    decode: func(data: list<u8>) -> result<x86-instruction, pe-error>;
}