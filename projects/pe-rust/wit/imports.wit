/// PE import tables interface
/// Defines structures for PE file import tables
interface imports {
    /// Import table entry structure
    /// Represents an imported function from a DLL
    record import-entry {
        /// Name of the imported function
        function-name: string,
        /// Ordinal number (if imported by ordinal)
        ordinal: option<u16>,
        /// Import address table offset
        iat-offset: u32,
    }

    /// Import table structure
    /// Represents imports from a single DLL
    record import-table {
        /// Name of the DLL being imported from
        dll-name: string,
        /// List of imported functions from this DLL
        imports: list<import-entry>,
        /// Import lookup table RVA
        import-lookup-table-rva: u32,
        /// Time/date stamp
        time-date-stamp: u32,
        /// Forwarder chain
        forwarder-chain: u32,
        /// Name RVA
        name-rva: u32,
        /// Import address table RVA
        import-address-table-rva: u32,
    }
}