/// x64 instruction set interface
/// Defines x64 architecture instructions and operands
interface x64-instructions {
    use types.{pe-error, encoded-instruction};
    
    /// x64 instruction operands
    /// Represents different types of operands for x64 instructions
    variant x64-operand {
        /// 8-bit register operand
        reg8(u8),
        /// 16-bit register operand
        reg16(u16),
        /// 32-bit register operand
        reg32(u32),
        /// 64-bit register operand
        reg64(u64),
        /// 8-bit immediate value
        imm8(u8),
        /// 16-bit immediate value
        imm16(u16),
        /// 32-bit immediate value
        imm32(u32),
        /// 64-bit immediate value
        imm64(u64),
        /// Memory reference with displacement
        mem-disp(u64),
        /// Memory reference with base register and displacement
        mem-base-disp(tuple<u8, u64>),
        /// Memory reference with base, index registers and displacement
        mem-base-index-disp(tuple<u8, u8, u8, u64>),
        /// Relative offset for jump instructions
        rel-offset(u64),
        /// RIP-relative addressing
        rip-rel(u32),
    }
    
    /// x64 instruction opcodes
    /// Enumeration of common x64 instruction opcodes
    enum x64-opcode {
        // Data movement instructions
        mov,
        movabs,
        push,
        pop,
        lea,
        
        // Arithmetic instructions
        add,
        sub,
        mul,
        div,
        inc,
        dec,
        neg,
        
        // Logic instructions
        and,
        or,
        xor,
        not,
        test,
        
        // Shift/rotate instructions
        shl,
        shr,
        sar,
        rol,
        ror,
        
        // Control flow instructions
        jmp,
        je,
        jne,
        jg,
        jge,
        jl,
        jle,
        ja,
        jb,
        call,
        ret,
        
        // Stack instructions
        pushfq,
        popfq,
        
        // String instructions
        movs,
        cmps,
        scas,
        lods,
        stos,
        
        // I/O instructions
        in,
        out,
        
        // Flag control
        stc,
        clc,
        std,
        cld,
        
        // System instructions
        syscall,
        sysret,
        
        // SSE instructions
        movups,
        movaps,
        movss,
        movsd,
        addps,
        addpd,
        subps,
        subpd,
        mulps,
        mulpd,
        divps,
        divpd,
        
        // Other
        nop,
        int,
        hlt,
        ud2,
    }
    
    /// x64 instruction structure
    /// Represents a complete x64 instruction with opcode and operands
    record x64-instruction {
        /// Instruction opcode
        opcode: x64-opcode,
        /// Instruction operands (0-4 operands)
        operands: list<x64-operand>,
        /// Instruction prefix bytes (REX, etc.)
        prefixes: list<u8>,
        /// Instruction size in bytes
        size: u8,
        /// Whether instruction uses REX prefix
        uses-rex: bool,
    }
    
    /// Encodes an x64 instruction into binary form
    /// Takes an x64 instruction and returns its encoded form or error
    encode: func(instruction: x64-instruction) -> result<encoded-instruction, pe-error>;
    
    /// Decodes binary data into an x64 instruction
    /// Takes binary data and returns the decoded instruction or error
    decode: func(data: list<u8>) -> result<x64-instruction, pe-error>;
}