{
    "name": "@nyar/valkyrie",
    "version": "0.0.13",
    "description": "Valkyrie language package  - Asgard and Legion commands",
    "type": "module",
    "license": "MIT",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js"
    },
    "bin": {
        "legion": "bin/legion.mjs",
        "asgard": "bin/asgard.mjs"
    },
    "files": [
        "bin",
        "dist",
        "src",
        "readme.md"
    ],
    "scripts": {
        "build": "node ../../../../scripts/build-npm-package-js.mjs projects/nyar.ts/emulators/valkyrie",
        "prepare": "node ../../../../scripts/build-npm-package-js.mjs projects/nyar.ts/emulators/valkyrie",
        "prepack": "node ../../../../scripts/build-npm-package-js.mjs projects/nyar.ts/emulators/valkyrie && node ../../../../scripts/prepare-npm-publish.mjs"
    },
    "optionalDependencies": {
        "@nyar/valkyrie-darwin-arm64": "workspace:*",
        "@nyar/valkyrie-darwin-x64": "workspace:*",
        "@nyar/valkyrie-linux-x64": "workspace:*",
        "@nyar/valkyrie-win32-x64": "workspace:*"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "keywords": [
        "nyar",
        "nyar-vm",
        "valkyrie",
        "asgard",
        "legion"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-vm/nyar-vm.git",
        "directory": "projects/nyar.ts/emulators/valkyrie"
    },
    "publishConfig": {
        "access": "public"
    }
}
