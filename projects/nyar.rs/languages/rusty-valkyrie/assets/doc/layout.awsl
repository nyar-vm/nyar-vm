<widget layout>
<div slot="page">
<header slot="header">
<a slot="logo" :href="home_href">{site_title}</a>
</header>
<div slot="body">
<p>LEGION_DOC_SLOT</p>
</div>
<footer slot="footer">
<p>
    由
    <strong>legion doc</strong>
    生成
</p>
</footer>
</div>
</widget>
<style>
root { direction: vertical }
slot header { inset: 16; background: @panel }
slot logo { text: @title; color: @brand }
slot body { inset: 24; direction: vertical; width: fill }
slot footer { inset: 16; text: @caption; color: @ink-muted }
</style>
