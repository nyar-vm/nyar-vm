<widget hub><div slot="page">
<h1 slot="title">{title}</h1>
<p slot="subtitle">
    由
    <strong>legion doc</strong>
    生成
</p>
<div slot="cards">
    <a slot="card" :href="doc_href">
        <div slot="card-icon">DOC</div>
        <div slot="card-title">用户文档</div>
        <div slot="card-desc">{doc_desc}</div>
    </a>
</div>
</div>
</widget>
<style>
root { direction: vertical; cross-align: center; spacing: 16; inset: 32 }
slot title { text: @hero; color: @brand-strong }
slot subtitle { text: @body; color: @ink-muted }
slot cards { direction: horizontal; spacing: 16; main-align: center }
slot card { direction: vertical; spacing: 8; inset: 16; radius: 8; width: 240; background: @panel }
slot card-icon { text: @title; color: @brand }
slot card-title { text: @body; color: @ink }
slot card-desc { text: @caption; color: @ink-soft }
</style>
