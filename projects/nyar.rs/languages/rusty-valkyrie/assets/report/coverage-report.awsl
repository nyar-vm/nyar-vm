<widget coverage_report>
<div slot="cov-summary">
    覆盖率：
    <span id="pct">{summary_text}</span>
</div>
<div slot="progress">
    <div slot="bar" style="{bar_style}">{pct_label}</div>
</div>
<if :condition="has_charts">
    <div slot="charts">
        <div slot="chart-panel">
            <p>LEGION_CHART_COVERAGE_BALANCE</p>
        </div>
        <div slot="chart-panel">
            <p>LEGION_CHART_COVERAGE_FEATURES</p>
        </div>
    </div>
</if>
<table slot="table">
    <thead>
        <tr>
            <th slot="th">特性</th>
            <th slot="th">状态</th>
            <th slot="th">测试项目</th>
        </tr>
    </thead>
    <tbody>
        <loop feature in {features}>
            <tr>
                <td slot="td">{feature.display}</td>
                <td slot="td">{feature.status}</td>
                <td slot="td">{feature.projects_text}</td>
            </tr>
        </loop>
    </tbody>
</table>
</widget>
<style>
slot cov-summary { direction: horizontal; main-align: center; spacing: 8; text: @title; color: @ink-muted }
#pct { color: @brand-strong }
slot progress { width: fill; height: 28; radius: 12; background: @panel-hover }
slot bar { height: fill; radius: 12; background: @brand-strong; direction: vertical; main-align: center; cross-align: center; text: @caption; color: @ink }
slot charts { direction: horizontal; spacing: 16 }
slot chart-panel { inset: 16; radius: 8; background: @panel; color: @ink }
slot table { width: fill; radius: 8; background: @panel; color: @ink }
slot th { inset: 8; text: @caption; color: @ink-soft }
slot td { inset: 8; text: @body; color: @ink }
</style>
