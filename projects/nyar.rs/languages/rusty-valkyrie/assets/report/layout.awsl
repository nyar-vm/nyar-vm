<widget layout>
<div slot="page">
<header slot="header">
<h1 slot="title">{page_title}</h1>
</header>
<div slot="body">
<p>LEGION_REPORT_SLOT</p>
</div>
<footer slot="footer">
<p>Generated by Legion CLI</p>
</footer>
</div>
</widget>
<style>
root { direction: vertical }
slot header { inset: 16; background: @panel }
slot title { text: @title; color: @ink }
slot body { inset: 24; width: fill; max-width: 960; direction: vertical }
slot footer { inset: 16; color: @ink-muted; text: @caption }
</style>
