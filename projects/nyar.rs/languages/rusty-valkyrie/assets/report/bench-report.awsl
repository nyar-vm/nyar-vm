<widget bench_report>
<div slot="card">
    <h2 slot="heading">Benchmark Report</h2>
    <p slot="summary">{summary_text}</p>
    <if :condition="has_charts">
        <div slot="charts">
            <div slot="chart-panel">
                <p>LEGION_CHART_BENCH_RUNTIME</p>
            </div>
            <div slot="chart-panel">
                <p>LEGION_CHART_BENCH_COMPILE</p>
            </div>
        </div>
    </if>
    <table slot="table">
        <thead>
            <tr>
                <th slot="th">Project</th>
                <th slot="th">Test</th>
                <th slot="th">Target</th>
                <th slot="num">Compile Time (ms)</th>
                <th slot="num">Runtime (ms)</th>
            </tr>
        </thead>
        <tbody>
            <loop row in {rows}>
                <tr>
                    <td slot="td">{row.project}</td>
                    <td slot="td">{row.test}</td>
                    <td slot="td">{row.target}</td>
                    <td slot="num">{row.compile_ms}</td>
                    <td slot="num">{row.runtime_ms}</td>
                </tr>
            </loop>
        </tbody>
    </table>
</div>
</widget>
<style>
slot card { direction: vertical; spacing: 16; inset: 24; radius: 8; background: @panel }
slot heading { text: @title; color: @ink }
slot summary { text: @body; color: @ink-soft }
slot charts { direction: horizontal; spacing: 16 }
slot chart-panel { inset: 12; radius: 8; background: @surface; color: @ink }
slot table { width: fill; radius: 8; background: @surface; color: @ink }
slot th { inset: 8; text: @caption; color: @ink-soft }
slot td { inset: 8; text: @body; color: @ink }
slot num { inset: 8; text: @body; color: @ink; main-align: end }
</style>
