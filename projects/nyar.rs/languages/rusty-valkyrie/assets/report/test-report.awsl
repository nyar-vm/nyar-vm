<widget test_report>
<div slot="summary">
    <div slot="card" id="summary-pass">
        <div slot="count">{passed}</div>
        <div slot="label">通过</div>
    </div>
    <div slot="card" id="summary-fail">
        <div slot="count">{failed}</div>
        <div slot="label">失败</div>
    </div>
    <div slot="card" id="summary-skip">
        <div slot="count">{skipped}</div>
        <div slot="label">跳过</div>
    </div>
</div>
<if :condition="has_chart">
    <div slot="charts">
        <div slot="chart-panel">
            <p>LEGION_CHART_STATUS</p>
        </div>
    </div>
</if>
<if :condition="has_rows">
    <table slot="table">
        <thead>
            <tr>
                <th slot="th">测试名称</th>
                <th slot="th">状态</th>
                <th slot="th">目标平台</th>
                <th slot="th">错误信息</th>
            </tr>
        </thead>
        <tbody>
            <loop row in {rows}>
                <tr>
                    <td slot="td">{row.name}</td>
                    <td slot="td">
                        <span slot="badge">{row.status_label}</span>
                    </td>
                    <td slot="td">{row.target}</td>
                    <td slot="error">{row.error}</td>
                </tr>
            </loop>
        </tbody>
    </table>
    <else />
    <div slot="empty">无测试结果</div>
</if>
</widget>
<style>
slot summary { direction: horizontal; spacing: 16 }
slot card { direction: vertical; cross-align: center; spacing: 4; inset: 16; radius: 8; background: @panel }
#summary-pass { background: @ok }
#summary-fail { background: @danger }
#summary-skip { background: @warn }
slot count { text: @value; color: @ink }
slot label { text: @caption; color: @ink-soft }
slot charts { direction: horizontal; spacing: 16 }
slot chart-panel { inset: 16; radius: 8; background: @panel; color: @ink }
slot table { width: fill; background: @panel; color: @ink; radius: 8 }
slot th { inset: 8; text: @caption; color: @ink-soft }
slot td { inset: 8; text: @body; color: @ink }
slot badge { inset: 2; radius: 6; background: @panel-hover; color: @ink; text: @caption }
slot error { inset: 8; text: @caption; color: @danger }
slot empty { inset: 32; text: @body; color: @ink-muted; background: @panel; radius: 8 }
</style>
