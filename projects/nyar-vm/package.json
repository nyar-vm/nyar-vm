{
    "name": "@nyar/vm",
    "version": "0.1.0",
    "description": "Nyar VM - Virtual machine and runtime environment for the Nyar programming language",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite build --watch",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@nyar/diagnostics": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.0.0",
        "vite": "^5.0.0",
        "vitest": "^1.0.0"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "nyar",
        "virtual-machine",
        "runtime",
        "language-runtime",
        "bytecode",
        "compiler-runtime"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/nyar-framework/nyar-vm.git",
        "directory": "projects/nyar-vm"
    }
}