{
  "name": "@nyar/diagnostics",
  "version": "0.0.1",
  "type": "module",
  "description": "Nyar diagnostic utilities - Source locations, error reporting, and diagnostics",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {},
  "keywords": [
    "nyar",
    "diagnostics",
    "compiler",
    "source-maps",
    "error-reporting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyar-framework/nyar-vm.git",
    "directory": "projects/diagnostics"
  }
}